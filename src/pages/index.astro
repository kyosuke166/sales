---
import Layout from '../layouts/Layout.astro';

const menus = [
    { 
        title: "会社・担当者管理", 
        icon: "fa-address-book", 
        href: "/crm", 
        color: "bg-blue-600", 
        active: true 
    },
    { 
        title: "グループ会社一覧", 
        icon: "fa-layer-group", 
        href: "/crm/group/", 
        color: "bg-cyan-500", 
        active: true 
    },
    { 
        title: "Google連絡先連携", 
        icon: "fa-brands fa-google", 
        href: "crm/googlecontact/", 
        color: "bg-emerald-600", 
        active: true 
    },
    { 
        title: "交流会・イベント管理", 
        icon: "fa-people-group", 
        href: "/event", 
        color: "bg-amber-500", 
        active: true 
    },
    { 
        title: "注文書・請求書", 
        icon: "fa-file-invoice-dollar", 
        href: "#", 
        color: "bg-slate-400", 
        active: false, 
        status: "DEVELOP" 
    },
    { 
        title: "TODO・覚書", 
        icon: "fa-list-check", 
        href: "#", 
        color: "bg-slate-400", 
        active: false, 
        status: "PLAN" 
    },
    { 
        title: "勤務表・出張手当", 
        icon: "fa-calendar-check", 
        href: "#", 
        color: "bg-slate-400", 
        active: false, 
        status: "TODO" 
    },
    { 
        title: "銀行取引情報", 
        icon: "fa-building-columns", 
        href: "#", 
        color: "bg-slate-400", 
        active: false, 
        status: "PLAN" 
    },
    { 
        title: "購買・契約管理", 
        icon: "fa-cart-shopping", 
        href: "#", 
        color: "bg-slate-400", 
        active: false, 
        status: "PLAN" 
    },
    { 
        title: "漏洩情報の管理", 
        icon: "fa-gears", 
        href: "/leak", 
        color: "bg-slate-500", 
        active: true 
    },
];
---

<Layout title="SBT 事務管理ダッシュボード">
    <main class="max-w-6xl mx-auto px-6 py-12">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {menus.map((menu) => (
                <a 
                    href={menu.active ? menu.href : "#"} 
                    class={`group flex items-center p-5 bg-white rounded-2xl border border-slate-200 shadow-sm transition-all duration-300 ${menu.active ? 'hover:shadow-lg hover:border-blue-400 hover:-translate-y-1' : 'opacity-60 grayscale-[0.5] cursor-not-allowed'}`}
                >
                    <div class={`${menu.color} w-12 h-12 rounded-xl flex-shrink-0 flex items-center justify-center text-white shadow-md group-hover:scale-110 transition-transform duration-300`}>
                        <i class={`fa-solid ${menu.icon} text-xl`}></i>
                    </div>
                    
                    <div class="ml-4 flex-grow min-w-0">
                        <div class="flex items-center justify-between gap-2">
                            <h2 class="text-base font-bold text-slate-800 truncate group-hover:text-blue-600 transition-colors">
                                {menu.title}
                            </h2>
                            {menu.status && (
                                <span class="px-2 py-0.5 bg-slate-100 text-slate-500 text-[9px] font-bold rounded-md tracking-wider flex-shrink-0 uppercase">
                                    {menu.status}
                                </span>
                            )}
                        </div>
                    </div>

                    {menu.active && (
                        <i class="fa-solid fa-chevron-right text-slate-300 text-xs ml-2 group-hover:text-blue-500 group-hover:translate-x-1 transition-all"></i>
                    )}
                </a>
            ))}
        </div>
    </main>
</Layout>
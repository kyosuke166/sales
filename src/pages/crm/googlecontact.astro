---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Google連絡先 同期管理">
  <main class="p-6 max-w-4xl mx-auto">
    <h1 class="text-2xl font-bold mb-6 flex items-center gap-2">
      <span class="icon-[logos--google-gmail]"></span> Google連絡先 同期管理
    </h1>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
      <div class="bg-white p-4 rounded-lg shadow border border-gray-200">
        <p class="text-sm text-gray-500">CRM同期対象</p>
        <p class="text-3xl font-bold text-blue-600" id="crm-count">--- <span class="text-lg font-normal text-gray-400 text-base">件</span></p>
        <p class="text-xs text-gray-400 mt-1">sort: 0,1,3 & telあり</p>
      </div>
      <div class="bg-white p-4 rounded-lg shadow border border-gray-200">
        <p class="text-sm text-gray-500">Google連絡先</p>
        <p class="text-3xl font-bold text-green-600" id="google-count">--- <span class="text-base font-normal text-gray-400">件</span></p>
      </div>
      <div class="bg-white p-4 rounded-lg shadow border border-gray-200">
        <p class="text-sm text-gray-500">Google未登録</p>
        <p class="text-3xl font-bold text-orange-500" id="diff-count">--- <span class="text-base font-normal text-gray-400">件</span></p>
      </div>
    </div>

    <div class="space-y-4">
      <section class="bg-gray-50 p-6 rounded-xl border border-gray-200">
        <h2 class="font-bold mb-4 flex items-center gap-2">
          <span class="text-blue-500">①</span> Googleへの書き出し
        </h2>
        <div class="flex flex-col md:flex-row items-start md:items-center gap-4">
          <button id="btn-export" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-md font-medium transition-colors shadow-sm">
            未登録分をGoogleへ送る
          </button>
          <p class="text-sm text-gray-600">
            CRMにのみ存在する電話番号を、新規連絡先としてGoogleに作成します。
          </p>
        </div>
      </section>

      <section class="bg-gray-50 p-6 rounded-xl border border-gray-200">
        <h2 class="font-bold mb-4 flex items-center gap-2">
          <span class="text-green-500">②</span> データの突合・クレンジング
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <button id="btn-check-diff" class="bg-white border border-gray-300 hover:bg-gray-100 px-4 py-2 rounded shadow-sm text-left">
            <span class="block font-medium">データの差異をチェック</span>
            <span class="text-xs text-gray-500">両方にあるが名前・会社名等が違う人をリストアップ</span>
          </button>
          <button id="btn-check-dup" class="bg-white border border-gray-300 hover:bg-gray-100 px-4 py-2 rounded shadow-sm text-left">
            <span class="block font-medium">重複データ検知</span>
            <span class="text-xs text-gray-500">同じ電話番号が複数登録されている人をチェック</span>
          </button>
        </div>
      </section>
    </div>

    <div id="log-container" class="mt-8 bg-black text-green-400 p-4 rounded-lg font-mono text-sm h-64 overflow-y-auto hidden">
      <p>>>> 同期ログ...</p>
    </div>
  </main>
</Layout>

<script>
  // is:inline を付けないことで、Astroが適切にビルド・最適化します
  async function fetchStats() {
    try {
      const response = await fetch('/api/google_check_stats.php');
      // レスポンスがJSONでない（404や500エラー）場合に備えてチェック
      if (!response.ok) throw new Error('Network response was not ok');
      
      const data = await response.json();

      if (data.success) {
        // IDが存在することを確認してから代入
        const crmEl = document.getElementById('crm-count');
        const googleEl = document.getElementById('google-count');
        const diffEl = document.getElementById('diff-count');

        if (crmEl) crmEl.innerHTML = `${data.crm_total} <span class="text-base font-normal text-gray-400">件</span>`;
        if (googleEl) googleEl.innerHTML = `${data.google_total} <span class="text-base font-normal text-gray-400">件</span>`;
        if (diffEl) diffEl.innerHTML = `${data.diff_count} <span class="text-base font-normal text-gray-400">件</span>`;
      } else {
        console.error("API Error:", data.message);
      }
    } catch (error) {
      console.error("Fetch Error:", error);
    }
  }

  // 実行
  fetchStats();
</script>
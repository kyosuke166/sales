---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="グループ会社一覧 | 管理画面">
    <main class="p-4 md:p-6 max-w-[1400px] mx-auto">
        <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm mb-6">
            <h1 class="text-xl font-bold text-slate-800 flex items-center gap-3">
                <i class="fa-solid fa-layer-group text-blue-500"></i>
                グループ会社一覧
            </h1>
            <p class="text-slate-500 text-xs mt-2">
                会社情報の「グループ名」に値が入っているデータを集計しています。
            </p>
        </div>

        <div id="groupContainer" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <div class="col-span-full py-20 text-center text-slate-400">読み込み中...</div>
        </div>
    </main>
</Layout>

<script>
    async function renderGroups() {
        const container = document.getElementById('groupContainer');
        if (!container) return;

        try {
            const res = await fetch('/api/get_groups.php'); // パスは環境に合わせて調整してください
            const result = await res.json();

            if (result.status === 'success' && result.data.length > 0) {
                container.innerHTML = result.data.map(group => `
                    <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden flex flex-col">
                        <div class="bg-slate-50 px-4 py-3 border-b border-slate-200 flex justify-between items-center">
                            <span class="font-bold text-slate-700 truncate" title="${group.name}">${group.name}</span>
                            <span class="text-[10px] font-bold bg-blue-100 text-blue-600 px-2 py-0.5 rounded-full">
                                ${group.companies.length}社
                            </span>
                        </div>
                        <div class="p-2 space-y-1">
                            ${group.companies.map(c => `
                                <div class="flex items-center justify-between p-2 hover:bg-blue-50 rounded-lg transition-colors group">
                                    <div class="min-w-0 flex-grow">
                                        <div class="text-sm font-medium text-slate-700 truncate">${c.company_name}</div>
                                        <div class="text-[10px] text-slate-400 truncate">${c.company_kana || ''}</div>
                                    </div>
                                    <a href="/crm/?q=${encodeURIComponent(c.company_name)}" 
                                       class="ml-2 p-1.5 text-slate-300 hover:text-blue-600 transition-colors"
                                       title="メイン画面で検索">
                                        <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
                                    </a>
                                </div>
                            `).join('')}
                        </div>
                    </div>
                `).join('');
            } else {
                container.innerHTML = '<div class="col-span-full py-20 text-center text-slate-400">グループ設定されている会社はありません。</div>';
            }
        } catch (e) {
            container.innerHTML = '<div class="col-span-full py-20 text-center text-red-400">データの取得に失敗しました。</div>';
        }
    }

    renderGroups();
</script>
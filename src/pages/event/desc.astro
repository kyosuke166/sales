---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="イベント参加者名簿">
  <main>
    <div id="desc-container">
      <div class="loading">読み込み中...</div>
    </div>
  </main>
</Layout>

<style is:global>
  /* 既存のスタイルは維持 */
  .header-container { 
    display: flex; 
    justify-content: space-between; 
    align-items: center; 
    margin: 20px 10px; 
    padding-bottom: 10px; 
    border-bottom: 3px solid #333; 
  }
  
  .header-container h2 { 
    margin: 0; 
    font-size: 1.2rem; 
    position: relative; 
    padding-left: 15px; 
    line-height: 1.4;
  }
  
  .header-container h2::before { 
    content: ""; 
    position: absolute; 
    left: 0; top: 10%; height: 80%; width: 5px; 
    background: #28a745; 
    border-radius: 2px; 
  }
  .nav-bar { display: flex; justify-content: space-between; align-items: center; margin: 15px 10px 10px 10px; }
  .back-link { font-size: 0.9rem; color: #007bff; text-decoration: none; font-weight: bold; }
  .table-wrapper { margin: 0 10px 30px 10px; border: 1px solid #333; border-radius: 8px; overflow: hidden; background: #fff; }
  .participant-table { width: 100%; border-collapse: collapse; table-layout: fixed; }
  .participant-table th { background: #333; color: #fff; padding: 12px 10px; font-size: 0.85rem; text-align: left; }
  .participant-table td { border-bottom: 1px solid #eee; padding: 10px; font-size: 0.9rem; vertical-align: middle; }
  .email-row td { padding-top: 0; padding-bottom: 12px; color: #666; font-size: 0.8rem; }

  .action-btns { display: flex; gap: 6px; align-items: center; }
  .btn-action { width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; padding: 0; border-radius: 6px; border: 1px solid #ddd; background: #f8f9fa; cursor: pointer; transition: all 0.2s; }
  .btn-action i { font-size: 1rem; display: inline-block; line-height: 1; }

  /* メモボタン用の色設定 */
  .btn-memo { background: #e0f2f1; border-color: #4db6ac; color: #00796b; }
  .btn-memo.empty { background: #f8f9fa; border-color: #ddd; color: #ccc; }

  .linked { background: #e3f2fd; border-color: #1976d2; color: #1976d2; }
  .unlinked { color: #888; }
  .btn-send { background: #fff3e0; border-color: #ff9800; color: #e65100; }
  .btn-nosend { background: #f5f5f5; color: #bbb; border-color: #ddd; }
  .loading { padding: 50px; text-align: center; color: #999; }

    /* CRMと自動照合ボタン */
  .controls-inline { display: flex; gap: 10px; }
  .btn-sync {
    padding: 8px 18px;
    background: #007bff;
    color: white;
    border: none;
    border-radius: 25px;
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: bold;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: all 0.2s;
  }
  .btn-sync:hover {
    background: #0056b3;
    transform: translateY(-2px);
    box-shadow: 0 4px 10px rgba(0,123,255,0.3);
  }

  @media (max-width: 768px) {
    /* --- 修正：ヘッダーを2列で見せる --- */
    .participant-table thead {
      display: block; /* ここを活かす */
      background: #333;
    }
    .participant-table thead tr {
      display: flex; /* 行をFlexboxに */
      padding: 0 5px;
      border: none;
    }
    /* 不要なヘッダー（No, 氏名, コメント）を隠す */
    .participant-table th:nth-child(1),
    .participant-table th:nth-child(3),
    .participant-table th:nth-child(4) {
      display: none;
    }
    /* 「会社名」を見出しの左側に */
    .participant-table th:nth-child(2) {
      display: block;
      flex: 1; /* 左側を埋める */
      border: none;
      padding: 10px;
      color: #fff;
      font-size: 0.85rem;
    }
    /* 「連携・配信操作」を見出しの右側に */
    .participant-table th:nth-child(5) {
      display: block;
      width: 160px; /* ボディ側のアイコン幅と合わせる */
      text-align: right;
      border: none;
      padding: 10px;
      color: #fff;
      font-size: 0.85rem;
    }
      
    .participant-table tbody, 
    .participant-table tr { 
      display: block; 
    }
    /* ↓ ここにあった display: none; の一行を削除しました ↓ */

    /* 1行目（社名、氏名、アイコンがある行）をFlexレイアウトに */
    .participant-table tr:not(.email-row) {
      display: flex;
      flex-wrap: wrap; /* 折り返しを許可 */
      align-items: center;
      padding: 10px 5px;
      border-bottom: none;
    }

    /* 不要な列（No、コメント）を隠す */
    .participant-table td:nth-child(1),
    .participant-table td[rowspan="2"]:nth-child(4) {
      display: none;
    }

    /* 左側エリア：会社名(2番目)と氏名(3番目) */
    .participant-table td:nth-child(2),
    .participant-table td:nth-child(3) {
      display: block;
      width: calc(100% - 160px) !important; 
      border: none !important;
      padding: 0 10px !important;
      order: 1; 
    }
    
    /* 氏名(3番目)を会社名の下にピタッとつける */
    .participant-table td:nth-child(3) {
      margin-top: 2px;
    }

    /* 右側エリア：操作ボタン(5番目) */
    .participant-table td:nth-child(5) {
      width: 160px !important;
      border: none !important;
      padding: 0 !important;
      order: 2; 
      display: flex;
      justify-content: flex-end;
    }

    /* メール行の調整 */
    .email-row {
      display: block;
      padding: 0 10px 10px 10px;
      border-bottom: 1px solid #eee;
    }
    .email-row td {
      display: block;
      width: 100% !important;
      border: none !important;
      padding: 0 !important;
    }

    /* アイコンが縦に並ばないように固定 */
    .action-btns {
      display: flex;
      flex-wrap: nowrap !important;
      gap: 4px;
    }
    .btn-action {
      width: 34px;
      height: 34px;
      flex-shrink: 0;
    }
  }
</style>

<script>
  async function init() {
    const urlParams = new URLSearchParams(window.location.search);
    const eventId = urlParams.get('id');
    const container = document.getElementById('desc-container');

    if (!eventId) return;

    try {
      const response = await fetch(`/api/get_participants.php?event_id=${eventId}`);
      const result = await response.json();

      if (result.success) {
        const e = result.event;
        const dateStr = e.event_date.split(' ')[0].replace(/-/g, '/');
        const organizer = e.organizer || 'SBT';
        const headerText = `${dateStr} ${e.event_number ? `${e.event_number} ` : ''}${e.event_name} ＠ ${e.area}${e.place ? `（${e.place}）` : ''} by ${organizer}`;

        container.innerHTML = `
          <div class="nav-bar">
            <a href="/event" class="back-link">← イベント一覧へ戻る</a>
          </div>
          <div class="header-container">
            <h2>${headerText}</h2>
            <div class="controls-inline">
              <button id="btn-sync-crm" class="btn-sync">
                <i class="fa-solid fa-rotate"></i> CRMと自動照合
              </button>
            </div>
          </div>
          <div class="table-wrapper">
            <table class="participant-table">
              <thead>
                <tr>
                  <th style="width:45px;">No</th>
                  <th style="width:22%;">会社名</th>
                  <th style="width:18%;">氏名</th>
                  <th>コメント</th>
                  <th style="width:260px;">連携・配信操作</th>
                </tr>
              </thead>
              <tbody>
                ${result.participants.map(p => `
                  <tr>
                    <td rowspan="2" style="text-align:center; background:#fcfcfc; border-bottom: 1px solid #eee;">
                      ${p.entry_number}
                    </td>
                    <td style="border-bottom:none;"><strong>${p.company_name || ''}</strong></td>
                    <td style="border-bottom:none;"><strong>${p.participant_name || ''}</strong></td>
                    <td rowspan="2" style="font-size:0.85rem; color:#555; border-bottom: 1px solid #eee;">
                      ${p.note || ''}
                    </td>
                    <td rowspan="2" style="border-bottom: 1px solid #eee;">
                      <div class="action-btns">
                        <button 
                          class="btn-action btn-co ${p.company_id ? 'linked' : 'unlinked'}" 
                          onclick="window.openLinkCompanyModal(${p.id})" 
                          title="${p.company_id ? `会社ID=${p.company_id} : ${p.crm_company_name || ''}` : '会社連携'}"
                        >
                          <i class="fa-solid fa-building"></i>
                        </button>

                        <button 
                          class="btn-action btn-user ${p.contact_id ? 'linked' : 'unlinked'}" 
                          title="${p.contact_id ? `担当者ID=${p.contact_id} : ${p.crm_contact_name || ''}` : '担当者連携'}"
                        >
                          <i class="fa-solid fa-user"></i>
                        </button>

                        <button 
                          class="btn-action btn-send-toggle ${p.send_flg == 1 ? 'btn-send' : 'btn-nosend'}" 
                          data-id="${p.id}" 
                          title="配信設定"
                        >
                          <i class="fa-solid fa-envelope"></i>
                        </button>

                        <button 
                          class="btn-action btn-memo-toggle ${p.memo ? 'btn-memo' : 'empty'}" 
                          data-id="${p.id}" 
                          data-memo="${p.memo || ''}" 
                          title="${p.memo || 'メモ編集'}"
                        >
                          <i class="fa-solid fa-note-sticky"></i>
                        </button>                      </div>
                    </td>
                  </tr>
                  <tr class="email-row">
                    <td colspan="2"><small>${p.email || ''}</small></td>
                  </tr>
                `).join('')}
              </tbody>
            </table>
          </div>
        `;

        // イベント委譲によるクリック処理
        container.addEventListener('click', async (e) => {
          const btnSend = e.target.closest('.btn-send-toggle');
          const btnMemo = e.target.closest('.btn-memo-toggle');

          // 1. 配信フラグの切り替え
          if (btnSend) {
            const id = btnSend.dataset.id;
            const currentIsSend = btnSend.classList.contains('btn-send');
            const newFlg = currentIsSend ? 0 : 1;

            await updateParticipant(id, { send_flg: newFlg }, () => {
              btnSend.classList.toggle('btn-send', newFlg === 1);
              btnSend.classList.toggle('btn-nosend', newFlg === 0);
            });
          }

          // 2. メモの更新
          if (btnMemo) {
            const id = btnMemo.dataset.id;
            const currentMemo = btnMemo.dataset.memo;
            const newMemo = prompt('メモを入力してください', currentMemo);
            
            if (newMemo !== null && newMemo !== currentMemo) {
              await updateParticipant(id, { memo: newMemo }, () => {
                btnMemo.dataset.memo = newMemo;
                btnMemo.classList.toggle('btn-memo', newMemo.length > 0);
                btnMemo.classList.toggle('empty', newMemo.length === 0);
              });
            }
          }
        });

        // 汎用アップデート関数
        async function updateParticipant(id, data, successCallback) {
          try {
            const formData = new URLSearchParams();
            formData.append('id', id);
            for (const key in data) {
              formData.append(key, data[key]);
            }

            const res = await fetch('/api/save_participant.php', {
              method: 'POST',
              body: formData
            });
            const updateResult = await res.json();

            if (updateResult.success) {
              successCallback();
            } else {
              alert('更新に失敗しました');
            }
          } catch (err) {
            console.error(err);
            alert('通信エラーが発生しました');
          }
        }

        document.getElementById('btn-sync-crm').onclick = async () => {
          const btn = document.getElementById('btn-sync-crm');
          btn.innerText = "照合中...";
          const formData = new URLSearchParams();
          formData.append('event_id', eventId);
          const res = await fetch('/api/sync_participants.php', { method: 'POST', body: formData });
          const syncRes = await res.json();
          alert(syncRes.message);
          location.reload();
        };
      }
    } catch (e) {
      container.innerHTML = `<p style="color:red; padding:20px;">エラーが発生しました</p>`;
    }
  }
  init();
</script>
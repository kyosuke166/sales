---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="イベント管理一覧">
  <main>
    <div class="header-container">
      <h2>イベント管理一覧</h2>
      <div class="controls">
        <a href="/event/sample_participant.csv" download="sample_participant.csv" class="btn-secondary btn-download">
          <i class="fa-solid fa-download"></i> フォーマット
        </a>
        <button id="btn-expand-all" class="btn-secondary">全て展開</button>
        <button id="btn-collapse-all" class="btn-secondary">全て畳む</button>
      </div>
    </div>
    <div id="event-list">読み込み中...</div>
  </main>

  <div id="context-menu" class="custom-context-menu" style="display:none;">
    <div id="menu-copy" class="menu-item"><i class="fa-regular fa-copy"></i> このイベントを複製</div>
  </div>

  <div id="event-modal" class="modal-overlay" style="display:none;">
    <div class="modal-content">
      <div class="modal-header">
        <h3 id="modal-title">イベント編集</h3>
        <button id="modal-close">&times;</button>
      </div>
      <form id="event-form">
        <input type="hidden" name="id" id="form-id">
        <div class="form-group">
          <label>開催日時 *</label>
          <input type="datetime-local" name="event_date" id="form-date" required>
        </div>
        <div class="form-group">
          <label>イベント名 *</label>
          <input type="text" name="event_name" id="form-name" required>
        </div>
        <div class="form-row">
          <div><label>回数</label><input type="text" name="event_number" id="form-number"></div>
          <div><label>定員</label><input type="number" name="capacity" id="form-capacity"></div>
        </div>
        <div class="form-row">
          <div><label>エリア</label><input type="text" name="area" id="form-area"></div>
          <div><label>会場名</label><input type="text" name="place" id="form-place"></div>
        </div>
        <div class="form-group">
          <label>主催者</label>
          <input type="text" name="organizer" id="form-organizer">
        </div>
        <div class="form-group">
          <label>参加費</label>
          <input type="number" name="price" id="form-price" placeholder="5000">
        </div>
        <div class="modal-footer">
          <button type="button" id="btn-cancel">キャンセル</button>
          <button type="submit" class="btn-primary">保存する</button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<style is:global>
  /* --- 1. タイトルと固定コントロールの装飾 --- */
  .header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 20px 10px;
    padding-bottom: 10px;
    border-bottom: 3px solid #333;
  }
  
  .header-container h2 {
    margin: 0;
    font-size: 1.5rem;
    position: relative;
    padding-left: 15px;
  }
  
  .header-container h2::before {
    content: "";
    position: absolute;
    left: 0;
    top: 15%;
    height: 70%;
    width: 5px;
    background: #007bff;
    border-radius: 2px;
  }

  /* 右上固定のコントロールパネル */
  .controls {
    position: fixed;
    top: 60px;
    right: 20px;
    z-index: 1000; /* 重なり順を一番上に */
    display: flex;
    gap: 10px;
    background: rgba(255, 255, 255, 0.85);
    padding: 12px;
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(0,0,0,0.05);
  }

  /* ボタン */
  .btn-secondary { 
    display: inline-flex;
    align-items: center;
    gap: 6px; /* アイコンと文字の間隔 */
    text-decoration: none; /* リンクの下線を消す */
    padding: 8px 18px; 
    font-size: 0.85rem; 
    font-weight: bold;
    cursor: pointer; 
    border: 1.5px solid #007bff; 
    background: #fff; 
    color: #007bff;
    border-radius: 25px;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* ダウンロードボタン専用（少し色を変えて区別してもOK） */
  .btn-download {
    border-color: #6c757d;
    color: #6c757d;
  }

  .btn-download:hover {
    background: #6c757d;
    color: #fff;
    border-color: #6c757d;
    box-shadow: 0 4px 10px rgba(108, 117, 125, 0.3);
  }

  .btn-secondary:hover { 
    background: #007bff; 
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 4px 10px rgba(0,123,255,0.3);
  }

  /* --- 2. 既存のテーブル・セクション構造 --- */
  .year-section { 
    margin: 0 10px 15px 10px; 
    border: 1px solid #333; 
    border-radius: 8px; 
    overflow: hidden; 
  }
  
  .year-title { background: #333; color: #fff; padding: 10px 15px; cursor: pointer; font-weight: bold; }
  .year-title::after { content: ' ▲'; float: right; font-size: 0.7rem; }
  .year-section.closed .year-title::after { content: ' ▼'; }

  .month-title { 
    background: #f8f9fa; 
    padding: 8px 15px 8px 30px; 
    cursor: pointer; 
    font-size: 0.95rem; 
    color: #555;
    border-top: 1px solid #ddd;
    display: flex;
    justify-content: space-between;
  }
  .month-title::after { content: ' ▲'; font-size: 0.6rem; }
  .month-section.closed .month-title::after { content: ' ▼'; }

  .admin-table { 
    table-layout: fixed;
    width: calc(100% - 30px);
    margin-left: 30px;
    border-collapse: collapse; 
    background: #fff;
  }

  .admin-table td { 
    border-bottom: 1px solid #f0f0f0; 
    padding: 10px 5px; 
    font-size: 0.9rem;
    vertical-align: middle;
  }

  .admin-table tr:hover { background-color: #fafafa; }

  .event-name-text {
    color: #333; /* イベント名はしっかり濃い色 */
  }

  .organizer-text {
    color: #666; /* 主催者は少しだけ薄くして、補足情報だとわかるように */
    font-size: 0.9em; /* ほんの少し小さくしてもお洒落です */
    font-weight: normal; /* 指定通り通常文字 */
  }

  /* 日付・列幅設定 */
  .date-box { display: flex; font-family: 'Courier New', Courier, monospace; font-size: 0.9rem; color: #666; }
  .date-m { width: 22px; text-align: right; }
  .date-s { width: 12px; text-align: center; }
  .date-d { width: 22px; text-align: right; }
  .date-w { width: 45px; text-align: center; color: #999; }

  .col-date   { width: 110px; }
  .col-name   { font-weight: bold; } /* ここは可変 */
  .col-area   { width: 100px; color: #0066cc; }
  .col-price  { width: 90px; text-align: right; }
  .col-count  { width: 100px; text-align: center; }
  .col-action { width: 60px; text-align: center; }  /* ボタン専用 */

  .btn-detail { padding: 5px 12px; background: #007bff; color: #fff; text-decoration: none; border-radius: 4px; font-size: 0.8rem; }
  .btn-detail:hover { background: #0056b3; }

  /* アコーディオン開閉制御 */
  .year-section.closed .year-content,
  .month-section.closed .month-content { display: none; }

  /* 右クリックメニュー */
  .custom-context-menu {
    position: absolute;
    background: white;
    border: 1px solid #ccc;
    box-shadow: 2px 2px 10px rgba(0,0,0,0.2);
    z-index: 1000;
    padding: 5px 0;
    border-radius: 4px;
  }
  .menu-item {
    padding: 8px 20px;
    cursor: pointer;
    font-size: 14px;
  }
  .menu-item:hover {
    background: #f0f7ff;
    color: #007bff;
  }

  /* モーダル */
  .modal-overlay {
    position: fixed;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0,0,0,0.6);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 2000;
  }
  .modal-content {
    background: white;
    padding: 25px;
    border-radius: 12px;
    width: 90%;
    max-width: 500px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.3);
  }
  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    border-bottom: 1px solid #eee;
    padding-bottom: 10px;
  }
  .form-group { margin-bottom: 15px; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 15px; }
  .form-group label, .form-row label { display: block; font-size: 12px; font-weight: bold; color: #666; }
  .form-group input, .form-row input { width: 100%; padding: 8px; border: 1px solid #ddd; border-radius: 4px; box-sizing: border-box; }
  .modal-footer { display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px; }
  .btn-primary { background: #007bff; color: white; border: none; padding: 10px 20px; border-radius: 6px; cursor: pointer; }
  .btn-primary:hover { background: #0056b3; }

  /* 人数がいる時のリンクバッジ */
  .count-link {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 3px;
    padding: 4px 10px;
    background: #e3f2fd;
    color: #007bff;
    text-decoration: none;
    border-radius: 20px;
    min-width: 70px;
  }
  .count-link:hover {
    background: #007bff;
    color: #fff;
  }
  .count-num { font-size: 1.1rem; }
  .count-sep { opacity: 0.4; }
  .count-cap { font-size: 0.9rem; }

  /* 0人の時の表示 */
  .no-participant-wrapper {
    display: inline-flex; /* flexからinline-flexに変更 */
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-width: 100px; /* 余裕を持たせる */
  }
  .count-zero { color: #bbb; font-size: 0.85rem; }

  /* 控えめだけど押しやすい登録ボタン */
  .btn-add-minimal {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 1px dashed #ccc;
    background: #fff;
    color: #999;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    transition: all 0.2s;
  }
  .btn-add-minimal:hover {
    border-style: solid;
    border-color: #28a745;
    color: #28a745;
    background: #e8f5e9;
    transform: scale(1.1);
  }

  .no-participant-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-width: 80px; /* 幅を固定してガタつきを抑える */
  }

  .count-link {
    min-width: 90px;
    display: inline-flex;
    justify-content: center;
    white-space: nowrap; /* 折り返し防止 */
  }
</style>

<script is:inline>
  // 日付をパーツに分けてHTML化
  const getFormattedDateHtml = (dateStr) => {
    const days = ['日', '月', '火', '水', '木', '金', '土'];
    const d = new Date(dateStr);
    const m = d.getMonth() + 1;
    const date = d.getDate();
    const w = days[d.getDay()];
    return `
      <div class="date-box">
        <span class="date-m">${m}</span>
        <span class="date-s">/</span>
        <span class="date-d">${date}</span>
        <span class="date-w">(${w})</span>
      </div>
    `;
  };

  // モーダルを開く関数（HTMLのonclickから呼べるようにwindowに紐付け）
  window.openModal = (data, mode = 'edit') => {
    const modal = document.getElementById('event-modal');
    const titleEl = document.getElementById('modal-title');
    if (!modal) return;

    if (mode === 'edit') {
      titleEl.innerText = 'イベント情報を編集';
      document.getElementById('form-id').value = data.id || '';
      document.getElementById('form-date').value = (data.date || '').replace(' ', 'T').slice(0, 16);
      document.getElementById('form-name').value = data.name || '';
      document.getElementById('form-number').value = data.number || '';
      document.getElementById('form-capacity').value = data.capacity || '';
      document.getElementById('form-area').value = data.area || '';
      document.getElementById('form-place').value = data.place || '';
      document.getElementById('form-price').value = data.price || '';
      document.getElementById('form-organizer').value = data.organizer || '';
    } else if (mode === 'copy') {
      titleEl.innerText = 'イベントを複製して新規登録';
      document.getElementById('form-id').value = ''; // 新規扱い
      document.getElementById('form-date').value = (data.date || '').replace(' ', 'T').slice(0, 16);
      document.getElementById('form-name').value = data.name || '';
      
      // 回数を自動インクリメント（例: #121 -> #122）
      const currentNum = parseInt((data.number || '').replace(/[^0-9]/g, ''));
      document.getElementById('form-number').value = isNaN(currentNum) ? data.number : `＃${currentNum + 1}`;
      
      document.getElementById('form-capacity').value = data.capacity || '';
      document.getElementById('form-area').value = data.area || '';
      document.getElementById('form-place').value = data.place || '';
      document.getElementById('form-price').value = data.price || '';
      document.getElementById('form-organizer').value = data.organizer || '';
    }
    modal.style.display = 'flex';
  };

  // CSVインポート
  window.triggerImport = (eventId, eventName) => {
    const input = document.createElement('input');
    input.type = 'file';
    input.accept = '.csv';
    input.name = 'csv';
    input.onchange = (e) => {
      const file = e.target.files[0];
      if (!file) return;

      // 1. 一時的なフォームを作成
      const form = document.createElement('form');
      form.method = 'POST';
      form.action = '/api/import_participants.php';
      form.enctype = 'multipart/form-data';
      form.style.display = 'none';

      // 2. event_id を追加
      const eventIdInput = document.createElement('input');
      eventIdInput.type = 'hidden';
      eventIdInput.name = 'event_id';
      eventIdInput.value = eventId;

      // 3. 選択されたファイルをフォームに入れる
      // そのまま input を append することでファイル保持
      form.appendChild(input);
      form.appendChild(eventIdInput);

      document.body.appendChild(form);
      form.submit();
    };
    input.click();
  };

  let selectedData = null; // 右クリック用保持

  async function loadEvents() {
    try {
      const response = await fetch('/api/get_events.php');
      const result = await response.json();
      if (!result.success) return;

      const container = document.querySelector('#event-list');
      const now = new Date();
      const twoMonthsAgo = new Date();
      twoMonthsAgo.setMonth(now.getMonth() - 2);

      // グルーピング
      const grouped = {};
      result.data.forEach(e => {
        const d = new Date(e.event_date);
        const year = d.getFullYear();
        const month = d.getMonth() + 1;
        if (!grouped[year]) grouped[year] = { months: {}, hasRecent: false };
        if (!grouped[year].months[month]) grouped[year].months[month] = [];
        grouped[year].months[month].push(e);
        if (d >= twoMonthsAgo) grouped[year].hasRecent = true;
      });

      let html = '';
      for (const year in grouped) {
        const yearClosed = grouped[year].hasRecent ? '' : 'closed';
        html += `<div class="year-section ${yearClosed}" data-node="year">
                  <h3 class="year-title" onclick="this.parentElement.classList.toggle('closed')">${year}年</h3>
                  <div class="year-content">`;
        for (const month in grouped[year].months) {
          const events = grouped[year].months[month];
          const monthClosed = new Date(events[events.length-1].event_date) >= twoMonthsAgo ? '' : 'closed';
          html += `
            <div class="month-section ${monthClosed}" data-node="month">
              <h4 class="month-title" onclick="this.parentElement.classList.toggle('closed')">${month}月</h4>
              <div class="month-content">
                <table class="admin-table">
                  <tbody>
                    ${events.map(e => `
                      <tr class="event-row" 
                          data-id="${e.id}" data-date="${e.event_date}" data-name="${e.event_name}" 
                          data-number="${e.event_number || ''}" data-capacity="${e.capacity || ''}" 
                          data-area="${e.area || ''}" data-place="${e.place || ''}" 
                          data-price="${e.price || ''}" data-organizer="${e.organizer || ''}">
                        <td class="col-date">${getFormattedDateHtml(e.event_date)}</td>
                        <td class="col-name" onclick="window.openModal(this.closest('tr').dataset, 'edit')" style="cursor:pointer;">
                          <strong>${e.event_number || ''} ${e.event_name}</strong>
                          ${e.organizer ? `<span class="organizer-text">（${e.organizer}）</span>` : ''}
                        </td>
                        <td class="col-area">${e.area || '-'}</td>
                        <td class="col-price">${e.price ? `￥${Number(e.price).toLocaleString()}` : '-'}</td>
                        <td class="col-count">
                          ${(e.current_count || 0) > 0 ? `
                            <a href="/event/desc?id=${e.id}" class="count-link">
                              <span class="count-num">${e.current_count}</span><span class="count-sep">/</span><span class="count-cap">${e.capacity || '-'}</span>
                            </a>
                          ` : `<span class="count-zero">0 / ${e.capacity || '-'}</span>`}
                        </td>
                        <td class="col-action">
                          <button onclick="event.stopPropagation(); window.triggerImport(${e.id}, '${e.event_name}')" class="btn-add-minimal">
                            <i class="fa-solid fa-file-import"></i>
                          </button>
                        </td>
                      </tr>
                    `).join('')}
                  </tbody>
                </table>
              </div>
            </div>`;
        }
        html += `</div></div>`;
      }
      container.innerHTML = html;

      // 右クリック制御
      const contextMenu = document.getElementById('context-menu');
      container.oncontextmenu = (e) => {
        const row = e.target.closest('.event-row');
        if (!row) return;
        e.preventDefault();
        selectedData = row.dataset;
        contextMenu.style.top = `${e.pageY}px`;
        contextMenu.style.left = `${e.pageX}px`;
        contextMenu.style.display = 'block';
      };

      document.addEventListener('click', () => { contextMenu.style.display = 'none'; });
      document.getElementById('menu-copy').onclick = () => {
        if (selectedData) window.openModal(selectedData, 'copy');
      };

    } catch (e) { console.error("読み込み失敗", e); }
  }

  // 保存処理
  document.getElementById('event-form').onsubmit = async (e) => {
    e.preventDefault();
    const payload = Object.fromEntries(new FormData(e.target));
    const res = await fetch('/api/save_events.php', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    const result = await res.json();
    if (result.success) { alert('保存しました'); location.reload(); }
    else { alert('エラー: ' + result.message); }
  };

  // モーダル閉じる
  document.getElementById('modal-close').onclick = () => document.getElementById('event-modal').style.display = 'none';
  document.getElementById('btn-cancel').onclick = () => document.getElementById('event-modal').style.display = 'none';

  // 全開・全閉
  document.getElementById('btn-expand-all').onclick = () => document.querySelectorAll('[data-node]').forEach(el => el.classList.remove('closed'));
  document.getElementById('btn-collapse-all').onclick = () => document.querySelectorAll('[data-node]').forEach(el => el.classList.add('closed'));

  loadEvents();
</script>
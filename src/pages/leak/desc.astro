---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="漏洩宛先詳細">
  <main>
    <div id="desc-container">
      <div class="loading">読み込み中...</div>
    </div>
  </main>
</Layout>

<style is:global>
  /* 基本レイアウト */
  .header-container { display: flex; justify-content: space-between; align-items: center; margin: 20px 10px; padding-bottom: 10px; border-bottom: 3px solid #333; }
  .header-container h2 { margin: 0; font-size: 1.2rem; position: relative; padding-left: 15px; line-height: 1.4; flex: 1; }
  .header-container h2::before { content: ""; position: absolute; left: 0; top: 10%; height: 80%; width: 5px; background: #007bff; border-radius: 2px; }
  .nav-bar { display: flex; justify-content: space-between; align-items: center; margin: 15px 10px 10px 10px; }
  .back-link { font-size: 0.9rem; color: #007bff; text-decoration: none; font-weight: bold; }
  
  /* テーブルデザイン (event準拠) */
  .table-wrapper { margin: 0 10px 30px 10px; border: 1px solid #333; border-radius: 8px; overflow: hidden; background: #fff; }
  .participant-table { width: 100%; border-collapse: collapse; table-layout: fixed; }
  .participant-table th { background: #333; color: #fff; padding: 12px 10px; font-size: 0.85rem; text-align: left; }
  .participant-table td { border-bottom: 1px solid #eee; padding: 10px; font-size: 0.9rem; vertical-align: middle; }
  .email-row td { padding-top: 0; padding-bottom: 12px; color: #666; font-size: 0.8rem; }

  /* アクションボタン (event準拠) */
  .action-btns { display: flex; gap: 6px; align-items: center; }
  .btn-action { width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; padding: 0; border-radius: 6px; border: 1px solid #ddd; background: #f8f9fa; cursor: pointer; transition: all 0.2s; }
  .btn-action i { font-size: 1rem; display: inline-block; line-height: 1; }

  .linked { background: #e3f2fd; border-color: #1976d2; color: #1976d2; }
  .unlinked { color: #888; }
  .btn-mail { background: #fff3e0; border-color: #ff9800; color: #e65100; }
  .btn-mail.empty { background: #f8f9fa; border-color: #ddd; color: #ccc; }
  .btn-memo { background: #e0f2f1; border-color: #4db6ac; color: #00796b; }
  .btn-memo.empty { background: #f8f9fa; border-color: #ddd; color: #ccc; }

  .btn-sync { padding: 8px 18px; background: #007bff; color: white; border: none; border-radius: 25px; cursor: pointer; font-size: 0.85rem; font-weight: bold; display: flex; align-items: center; gap: 6px; }
  .loading { padding: 50px; text-align: center; color: #999; }

  /* モーダル用追加スタイル */
  .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); display: flex; align-items: center; justify-content: center; z-index: 1000; }
  .modal-content { background: #fff; width: 90%; max-width: 500px; border-radius: 8px; overflow: hidden; }
  .modal-header { padding: 15px; background: #f8f9fa; border-bottom: 1px solid #eee; display: flex; justify-content: space-between; align-items: center; }
  .company-item:hover { background: #f0f7ff; color: #007bff; }

  /* --- 漏洩宛先詳細：モバイル対応 --- */
  @media (max-width: 768px) {
    /* 1. ヘッダーとボタンの最適化 */
    .header-container {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
      margin: 15px 10px;
    }
    .header-container h2 {
      font-size: 1.0rem; /* 長いタイトル対策 */
      padding-left: 12px;
      flex: none;
      width: 100%;
    }
    .btn-sync {
      width: 100%;
      justify-content: center;
    }

    /* 2. テーブルの整理（Noとメールアドレス列の調整） */
    .table-wrapper {
      margin: 0 5px;
    }

    /* No列を非表示 */
    .participant-table th:nth-child(1),
    .participant-table td:nth-child(1) {
      display: none;
    }

    /* 列幅の再配分 */
    .participant-table th:nth-child(2) { width: 30% !important; } /* 会社名 */
    .participant-table th:nth-child(3) { width: 25% !important; } /* 氏名 */
    .participant-table th:nth-child(4) { width: 0; display: none; } /* メールのヘッダーを隠す */
    .participant-table td:nth-child(4) { display: none; } /* メールのセルを一旦隠す（下段のemail-rowがあるため） */
    .participant-table th:last-child { width: auto !important; } /* 操作 */

    .participant-table td {
      padding: 8px 5px;
      font-size: 0.8rem;
    }

    /* 3. アクションボタンを大きくして押しやすく */
    .action-btns {
      justify-content: flex-end;
      gap: 8px;
    }
    .btn-action {
      width: 42px; /* モバイル専用サイズ */
      height: 42px;
    }
    .btn-action i {
      font-size: 1.1rem;
    }

    /* 4. CRMリンク情報の調整（email-row） */
    .email-row td {
      font-size: 0.7rem;
      padding-top: 4px;
      padding-bottom: 10px;
      line-height: 1.4;
      background: #fdfdfd;
    }
    
    /* モーダルのレスポンシブ対応 */
    .modal-content {
      width: 95%;
      margin: 10px;
    }
  }
</style>

<script is:inline>
  async function init() {
    const urlParams = new URLSearchParams(window.location.search);
    const date = urlParams.get('date');
    const company = urlParams.get('company');
    const container = document.getElementById('desc-container');

    if (!date || !company) return;

    try {
      const response = await fetch(`/api/get_leakmail.php?date=${encodeURIComponent(date)}&company=${encodeURIComponent(company)}`);
      const result = await response.json();

      if (result.success) {
        const headerTitle = `${company} (${date.replace(/-/g, '/').replace('T', ' ')}) 漏洩宛先詳細`;

        container.innerHTML = `
        <div class="nav-bar">
            <a href="/leak" class="back-link">← 漏洩リスト一覧へ戻る</a>
        </div>
        <div class="header-container">
            <h2>${headerTitle}</h2>
            <div class="controls-inline">
            <button id="btn-sync-crm" class="btn-sync">
                <i class="fa-solid fa-rotate"></i> CRMと自動照合
            </button>
            </div>
        </div>
        <div class="table-wrapper">
            <table class="participant-table">
            <thead>
                <tr>
                <th style="width:45px;">No</th>
                <th style="width:25%;">会社名</th>
                <th style="width:20%;">氏名</th>
                <th>メールアドレス</th>
                <th style="width:200px;">連携・配信操作</th>
                </tr>
            </thead>
            <tbody>
                ${result.data.map(d => {
                // ツールチップ文字列の構築
                const coTitle = d.company_id 
                    ? `会社ID=${d.company_id}：${d.crm_company_name || '名称不明'}` 
                    : '会社連携';
                const userTitle = d.contact_id 
                    ? `担当者ID=${d.contact_id}：${d.crm_contact_name || '名称不明'}` 
                    : '担当者連携';
                const mailTitle = d.send_name || '配信名設定';
                const memoTitle = d.memo || 'メモ編集';

                return `
                    <tr>
                    <td rowspan="2" style="text-align:center; background:#fcfcfc; border-bottom: 1px solid #eee;">
                        ${d.seq_number}
                    </td>
                    <td style="border-bottom:none;"><strong>${d.raw_company || ''}</strong></td>
                    <td style="border-bottom:none;"><strong>${d.raw_person || ''}</strong></td>
                    <td rowspan="2" style="font-size:0.9rem; color:#333; border-bottom: 1px solid #eee;">
                        ${d.email || ''}
                        ${d.send_name ? `<div style="font-size:0.75rem; color:#e65100; margin-top:4px;">[配信名] ${d.send_name}</div>` : ''}
                    </td>
                    <td rowspan="2" style="border-bottom: 1px solid #eee;">
                        <div class="action-btns">
                        <button class="btn-action btn-co ${d.company_id ? 'linked' : 'unlinked'}" 
                            onclick="window.openLinkCompanyModal(${d.id})" 
                            title="${coTitle}">
                            <i class="fa-solid fa-building"></i>
                        </button>

                        <button class="btn-action btn-user ${d.contact_id ? 'linked' : 'unlinked'}" 
                            title="${userTitle}" style="cursor:default;">
                            <i class="fa-solid fa-user"></i>
                        </button>

                        <button class="btn-action btn-mail-toggle ${d.send_name ? 'btn-mail' : 'empty'}" 
                            data-id="${d.id}" data-val="${d.send_name || ''}" 
                            title="${mailTitle}">
                            <i class="fa-solid fa-envelope"></i>
                        </button>

                        <button class="btn-action btn-memo-toggle ${d.memo ? 'btn-memo' : 'empty'}" 
                            data-id="${d.id}" data-val="${d.memo || ''}" 
                            title="${memoTitle}">
                            <i class="fa-solid fa-note-sticky"></i>
                        </button>
                        </div>
                    </td>
                    </tr>
                    <tr class="email-row">
                    <td style="color:#666; font-size:0.8rem;">
                        ${d.crm_company_name ? `<i class="fa-solid fa-link"></i> ${d.crm_company_name}` : ''}
                    </td>
                    <td style="color:#666; font-size:0.8rem;">
                        ${d.crm_contact_name ? `<i class="fa-solid fa-link"></i> ${d.crm_contact_name}` : ''}
                    </td>
                    </tr>
                `;
                }).join('')}
            </tbody>
            </table>
        </div>
        `;
        
        // イベント委譲
        container.addEventListener('click', async (e) => {
          const btnMail = e.target.closest('.btn-mail-toggle');
          const btnMemo = e.target.closest('.btn-memo-toggle');

          if (btnMail) {
            const newName = prompt('配信用の宛名を入力してください', btnMail.dataset.val);
            if (newName !== null) updateField(btnMail.dataset.id, { send_name: newName });
          }
          if (btnMemo) {
            const newMemo = prompt('メモを入力してください', btnMemo.dataset.val);
            if (newMemo !== null) updateField(btnMemo.dataset.id, { memo: newMemo });
          }
        });

        // 照合ボタンの実装
        document.getElementById('btn-sync-crm').onclick = async () => {
          if (!confirm('CRMと自動照合しますか？')) return;
          const btn = document.getElementById('btn-sync-crm');
          btn.disabled = true;
          btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> 照合中...';
          const res = await fetch('/api/sync_leakmail.php', {
            method: 'POST',
            body: new URLSearchParams({ date: date.replace('T', ' '), company: company })
          });
          const r = await res.json();
          alert(r.message);
          location.reload();
        };
      }
    } catch (e) {
      container.innerHTML = `<p style="color:red; padding:20px;">エラーが発生しました</p>`;
    }
  }

  let currentTargetId = null; // 紐付け対象の leaked_contacts.id

  // 会社モーダルを開く
  window.openLinkCompanyModal = (id) => {
    currentTargetId = id;
    document.getElementById('company-modal').style.display = 'flex';
    document.getElementById('company-search').value = '';
    document.getElementById('company-list').innerHTML = '';
    document.getElementById('company-search').focus();
  };

  function closeCompanyModal() {
    document.getElementById('company-modal').style.display = 'none';
  }

  // 会社検索ロジック
  document.getElementById('company-search')?.addEventListener('input', async (e) => {
    const q = e.target.value;
    if (q.length < 2) return;

    const res = await fetch(`/api/search_companies.php?q=${encodeURIComponent(q)}`);
    const companies = await res.json();
    
    const list = document.getElementById('company-list');
    list.innerHTML = companies.map(c => `
      <div class="company-item" onclick="linkCompany(${c.id})" style="padding:10px; cursor:pointer; border-bottom:1px solid #eee;">
        ${c.company_name} <small style="color:#999;">(${c.domain || 'No Domain'})</small>
      </div>
    `).join('');
  });

  async function linkCompany(companyId) {
    if (!confirm('この会社を紐付けますか？')) return;
    await updateField(currentTargetId, { company_id: companyId });
    closeCompanyModal();
  }
  
  async function updateField(id, data) {
    const fd = new URLSearchParams();
    fd.append('id', id);
    for (const key in data) fd.append(key, data[key]);

    const res = await fetch('/api/save_leakmail.php', { method: 'POST', body: fd });
    const result = await res.json();
    if (result.success) location.reload();
    else alert('更新に失敗しました');
  }

  init();
</script>
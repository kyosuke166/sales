---
import Layout from '../../layouts/Layout.astro';

const currentUrl = new URL(Astro.request.url);
const historyId = currentUrl.searchParams.get('history_id');
const searchType = currentUrl.searchParams.get('type') ?? 'anken';
const isFree = searchType === 'free';
const isEngineer = searchType === 'engineer';

let title = '案件配信メール作成';
if (historyId) {
  title = '配信履歴の確認・再配信';
} else if (isFree) {
  title = 'フリーメール作成';
} else if (isEngineer) {
  title = 'エンジニア配信メール作成';
}
---

<Layout title={`${title} | メール配信管理`}>
  <main class="max-w-[1100px] mx-auto px-4 md:px-6 py-8">
    <a href="/sendmail" class="text-sm font-bold text-cyan-600 hover:text-cyan-700">
      <i class="fa-solid fa-chevron-left mr-1"></i> メール配信管理へ戻る
    </a>

    <div class="mt-6 bg-white border border-slate-200 rounded-2xl shadow-sm p-6">
      <div class="flex items-center gap-3 mb-8">
        <div id="pageIcon" class="w-11 h-11 rounded-xl bg-cyan-600 text-white flex items-center justify-center">
          <i class="fa-solid fa-paper-plane"></i>
        </div>
        <div>
          <p id="pageSubTitle" class="text-xs font-bold text-cyan-600 tracking-wider uppercase"></p>
          <h1 id="pageTitle" class="text-2xl font-bold text-slate-800">読み込み中...</h1>
        </div>
      </div>

      <!-- メタ情報パネル（フリーメールのときは非表示にする） -->
      <div id="metaPanel" class="relative mb-6 p-4 bg-slate-100 rounded-xl border border-slate-200">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div>
            <p class="text-[10px] uppercase font-bold text-slate-400" id="labelCol1">情報受領日</p>
            <p id="infoReceived" class="font-bold text-slate-700">読み込み中...</p>
          </div>
          <div>
            <p class="text-[10px] uppercase font-bold text-slate-400" id="labelCol2">情報元会社名</p>
            <p id="infoCompany" class="font-bold text-slate-700">読み込み中...</p>
          </div>
          <div>
            <p class="text-[10px] uppercase font-bold text-slate-400" id="labelCol3">情報元担当者</p>
            <p id="infoContact" class="font-bold text-slate-700">読み込み中...</p>
          </div>
          <div>
            <p class="text-[10px] uppercase font-bold text-slate-400" id="labelCol4">連絡手段</p>
            <p id="infoMethod" class="font-bold text-slate-700">読み込み中...</p>
          </div>
        </div>

        <button id="detailToggle" type="button" class="absolute top-4 right-4 text-xs font-bold text-cyan-600 hover:text-cyan-700 underline">
          <i class="fa-solid fa-up-right-from-square mr-1"></i>詳細
        </button>
      </div>

      <!-- 元情報パネル（フリーメールのときは非表示にする） -->
      <div id="detailPanel" class="hidden mb-8 rounded-xl border border-slate-200 bg-slate-100 p-4">
        <div class="flex items-center justify-between mb-3">
          <h2 class="text-sm font-bold text-slate-700" id="detailTitle">元情報</h2>
          <span class="text-xs text-slate-400" id="detailSubTitle">DBから取得した原文</span>
        </div>
        <div id="detailBody" class="whitespace-pre-wrap text-sm text-slate-600 leading-7"></div>
      </div>

      <form id="mailForm" class="space-y-6">
        <div>
          <label class="block text-sm font-bold text-slate-700 mb-2">件名</label>
          <input id="subjectInput" type="text" name="subject" class="w-full border-slate-300 rounded-lg shadow-sm focus:ring-cyan-500 focus:border-cyan-500 px-3 py-2" required />
        </div>

        <div>
          <label class="block text-sm font-bold text-slate-700 mb-2">前置き文</label>
          <textarea id="introInput" name="intro" rows="4" class="w-full border-slate-300 rounded-lg shadow-sm focus:ring-cyan-500 focus:border-cyan-500 px-3 py-2" placeholder="ご挨拶など" required></textarea>
        </div>

        <div>
          <label class="block text-sm font-bold text-slate-700 mb-2">本文</label>
          <div class="mb-2 text-sm text-slate-500">-・-・-・-・-・-・-・-・-・-・-・-・-・-・-・-・-</div>
          <textarea id="bodyInput" name="body" rows="20" class="w-full border-slate-300 rounded-lg shadow-sm focus:ring-cyan-500 focus:border-cyan-500 px-3 py-2" placeholder="自由な本文を入力" required></textarea>
          <div class="mt-2 text-sm text-slate-500">-・-・-・-・-・-・-・-・-・-・-・-・-・-・-・-・-</div>
        </div>

        <div>
          <label class="block text-sm font-bold text-slate-700 mb-2">署名</label>
          <textarea id="signatureInput" name="signature" rows="15" class="w-full border-slate-300 rounded-lg shadow-sm focus:ring-cyan-500 focus:border-cyan-500 px-3 py-2" required></textarea>
        </div>

        <div>
          <label class="block text-sm font-bold text-slate-700 mb-2">宛先</label>
          <textarea id="sendtoInput" name="sendto" rows="10" class="w-full border-slate-300 rounded-lg shadow-sm focus:ring-cyan-500 focus:border-cyan-500 px-3 py-2" placeholder="メールアドレスを入力" required></textarea>
        </div>

        <div class="pt-4 border-t border-slate-200 flex justify-end gap-3">
          <!-- 下書き保存ボタン（idを追加、type="button"） -->
          <button type="button" id="saveDraftBtn" class="px-6 py-2.5 bg-slate-100 text-slate-700 font-bold rounded-lg hover:bg-slate-200 transition">
            下書き保存
          </button>
          <!-- 確認ボタン（type="submit"のまま。HTML5のrequiredバリデーションを効かせるため） -->
          <button type="submit" class="px-6 py-2.5 bg-cyan-600 text-white font-bold rounded-lg hover:bg-cyan-700 transition shadow-sm">
            配信内容を確認する
          </button>
        </div>
      </form>
    </div>
  </main>

  <!-- ▼ 確認用モーダル (新規追加) ▼ -->
  <div id="confirmModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-[2px] z-[200] hidden flex items-center justify-center p-4">
      <div class="bg-white rounded-2xl shadow-2xl w-full max-w-4xl max-h-[90vh] flex flex-col overflow-hidden">
          <div class="px-6 py-4 border-b border-slate-200 flex justify-between items-center bg-slate-50">
              <h3 class="font-bold text-slate-800 text-lg flex items-center gap-2">
                  <i class="fa-solid fa-paper-plane text-cyan-600"></i> 送信内容の確認
              </h3>
              <button type="button" onclick="closeConfirmModal()" class="text-slate-400 hover:text-slate-600 transition">
                  <i class="fa-solid fa-xmark text-xl"></i>
              </button>
          </div>
          <div class="p-6 overflow-y-auto bg-slate-100 flex-1 grid grid-cols-1 md:grid-cols-3 gap-6">
              <!-- 左側：メールプレビュー -->
              <div class="md:col-span-2 flex flex-col gap-4">
                <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
                    <p class="text-[10px] font-bold text-slate-400 mb-1">件名</p>
                    <p id="previewSubject" class="font-bold text-slate-800"></p>
                </div>
                <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex-1">
                    <p class="text-[10px] font-bold text-slate-400 mb-2">本文</p>
                    <div id="previewBody" class="whitespace-pre-wrap text-sm text-slate-700 leading-relaxed font-mono"></div>
                </div>
              </div>
              <!-- 右側：宛先プレビュー -->
              <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm h-fit">
                  <p class="text-[10px] font-bold text-slate-400 mb-1">宛先</p>
                  <p id="previewToCount" class="text-sm font-bold text-slate-700 mb-3"></p>
                  <div id="previewTo" class="whitespace-pre text-[11px] text-slate-500 h-64 overflow-auto bg-slate-50 p-3 rounded-lg border border-slate-100 font-mono"></div>
              </div>
          </div>
          <div class="px-6 py-4 border-t border-slate-200 bg-white flex justify-end gap-3">
              <button type="button" onclick="closeConfirmModal()" class="px-6 py-2.5 bg-slate-100 text-slate-700 font-bold rounded-lg hover:bg-slate-200 transition">
                  戻って修正する
              </button>
              <button type="button" id="executeSendBtn" class="px-8 py-2.5 bg-cyan-600 text-white font-bold rounded-lg hover:bg-cyan-700 transition shadow-sm flex items-center gap-2">
                  <i class="fa-solid fa-paper-plane"></i> この内容で配信する
              </button>
          </div>
      </div>
  </div>
</Layout>

<script is:inline>
  const params = new URLSearchParams(window.location.search);
  const historyId = params.get('history_id');
  const type = params.get('type') ?? 'anken';
  const id = params.get('id') ?? '';
  
  const isFree = type === 'free';
  const isEngineer = type === 'engineer';
  const subjectPrefix = isEngineer ? '【SBT◆技術者】' : '【SBT◆案件】';

  const metaPanel = document.getElementById('metaPanel');
  const subjectInput = document.getElementById('subjectInput');
  const introInput = document.getElementById('introInput');
  const bodyInput = document.getElementById('bodyInput');
  const signatureInput = document.getElementById('signatureInput');
  const sendtoInput = document.getElementById('sendtoInput');

  function formatDate(value) {
    if (!value) return '未設定';
    const normalized = String(value).replace(/\s+/, '');
    if (/^\d{4}-\d{2}-\d{2}$/.test(normalized)) {
      return normalized.replace(/-/g, '/');
    }
    return normalized;
  }

  function normalizeValue(value) {
    return String(value ?? '').trim();
  }

  function formatSkillLines(value, withBullet = true) {
    const text = normalizeValue(value);
    if (!text) return [];
    return text
      .split(/\r?\n/)
      .map((line) => line.trim())
      .filter(Boolean)
      .map((line) => {
        const cleaned = line.replace(/^・\s*/, '');
        return withBullet ? `【 】${cleaned}` : cleaned;
      });
  }

  function buildSubject(row) {
    if (isEngineer) {
      const age = normalizeValue(row.age);
      const experienceYears = normalizeValue(row.experience_years);
      const price = normalizeValue(row.price) || '価格未設定';
      const period = normalizeValue(row.period) || '期間未設定';
      const nationality = normalizeValue(row.nationality);

      const subjectParts = ['●●エンジニア'];
      const detailParts = [];

      if (age) detailParts.push(age);
      if (experienceYears) detailParts.push(experienceYears);
      if (detailParts.length) subjectParts.push(detailParts.join('/'));

      subjectParts.push(price, period);

      if (nationality && nationality !== '日本') {
        subjectParts.push(`※${nationality}`);
      }

      return `${subjectPrefix}${subjectParts.join(' ◆ ')}`;
    }

    const area = normalizeValue(row.area) || 'エリア未設定';
    const price = normalizeValue(row.price) || '価格未設定';
    const period = normalizeValue(row.period) || '期間未設定';
    return `${subjectPrefix}${row.name || '案件名'}@${area} ◆ ${price} ◆ ${period}`;
  }

  function buildIntro(row) {
    if (isEngineer) {
      return [
        'エンジニアをご紹介します。',
        '活躍できる案件がありましたら、ご紹介いただけますと幸いです。',
      ].join('\n');
    }

    return [
      '案件をご紹介します。',
      '下記の案件にご対応可能な技術者がいらっしゃいましたら',
      'ご紹介いただけますと助かります。',
      'ご提案の際は、スキル要件の【○/△/✕】と最新の並行状況をいただけますと幸いです。'
    ].join('\n');
  }

  function buildBody(row) {
    const lines = [];

    if (isEngineer) {
      const skillsheetUrl = row.skillsheet
        ? (String(row.skillsheet).startsWith('http') ? row.skillsheet : `https://docs.google.com/spreadsheets/d/${row.skillsheet}`)
        : '---';

      const age = normalizeValue(row.age);
      const gender = normalizeValue(row.gender);
      const ageGender = [age, gender].filter(Boolean).join(' / ');
      const headingBody = ageGender ? `（${ageGender}）` : '';

      const suffixParts = [];
      const nationality = normalizeValue(row.nationality);
      if (nationality && nationality !== '日本') {
        suffixParts.push(`※${nationality}`);
      }
      const experienceYears = normalizeValue(row.experience_years);
      if (experienceYears) {
        suffixParts.push(`※経験${experienceYears}`);
      }

      const headingSuffix = suffixParts.length ? ` ${suffixParts.join('、')}` : '';
      lines.push(`■${row.name || '技術者名'}${headingBody}${headingSuffix}`);
      lines.push(skillsheetUrl);
      lines.push('');

      const engineerLines = [];
      if (row.period) engineerLines.push(`稼働可：${row.period}`);
      if (row.area) engineerLines.push(`最寄駅：${row.area}`);
      if (row.belong) engineerLines.push(`所属 ：${row.belong}`);
      if (row.price) engineerLines.push(`単金 ：${row.price}`);
      if (row.base_hours) engineerLines.push(`精算幅：${row.base_hours}`);
      if (row.hope) engineerLines.push(`希望 ：${row.hope}`);
      if (engineerLines.length) lines.push(...engineerLines);

      const licenseText = normalizeValue(row.license);
      if (licenseText) {
        lines.push('');
        lines.push('≪資格≫', licenseText);
      }

      const skillLines = formatSkillLines(row.skill, false);
      if (skillLines.length) {
        lines.push('');
        lines.push('≪スキル≫', ...skillLines);
      }

      const noteText = normalizeValue(row.note);
      if (noteText) {
        lines.push('');
        lines.push('≪備考≫', noteText);
      }
    } else {
      lines.push(`■${row.name || '案件名'}`, '');

      const ankenLines = [];
      if (row.period) ankenLines.push(`参画時期：${row.period}`);
      if (row.area) ankenLines.push(`作業場所：${row.area}`);
      if (row.work_time) ankenLines.push(`就業時間：${row.work_time}`);
      if (row.recruit) ankenLines.push(`募集人数：${row.recruit}`);
      if (row.interview) ankenLines.push(`面談  ：${row.interview}`);
      if (row.price) ankenLines.push(`単価  ：${row.price}`);
      if (row.base_hours) ankenLines.push(`精算幅 ：${row.base_hours}`);
      if (row.note) {
        ankenLines.push(`備考  ：${row.note}`);
      } else {
        ankenLines.push('備考  ：外国籍不可');
      }
      if (ankenLines.length) lines.push(...ankenLines);

      const overviewText = normalizeValue(row.overview);
      if (overviewText) {
        lines.push('', '≪案件概要≫', overviewText);
      }

      const requiredSkills = formatSkillLines(row.skill_must);
      if (requiredSkills.length) {
        lines.push('', '≪必須スキル≫', ...requiredSkills);
      }

      const optionalSkills = formatSkillLines(row.skill_want);
      if (optionalSkills.length) {
        lines.push('', '≪尚可スキル≫', ...optionalSkills);
      }
    }

    return lines.join('\n');
  }

  function buildSignature() {
    const footer = [
      '_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/',
      ' 株式会社ＳＢＴ',
      '   URL ： https://sbt-inc.co.jp',
      '   TEL ： 03-6912-8306',
      '   直通： 090-7755-0100 (柴田)',
      '   LINE： https://line.me/ti/p/bn7frp0fRL',
      '_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/',
      '',
      '▼協賛交流会(9月)',
      'https://www.kokuchpro.com/event/146432875406b42c12aa8b959394f381/',
      '',
      '▼情報交換LINE-Gr.',
      'https://tinyurl.com/yts48uuu'
    ];
    return footer.join('\n');
  }

  // 1. 履歴からの復元
  async function loadHistoryData(hId) {
    document.getElementById('pageSubTitle').textContent = 'History Archive';
    document.getElementById('pageTitle').textContent = '配信履歴の確認・再配信';

    try {
      const res = await fetch(`/api/get_sendmail_history.php?id=${hId}`, { credentials: 'include' });
      const result = await res.json();
      if (result.status !== 'success') throw new Error(result.message || '履歴の取得に失敗しました。');
      
      const row = result.data;
      
      if (!row.engineer_id && !row.anken_id) {
        metaPanel.classList.add('hidden'); // フリー配信の履歴ならメタ情報非表示
      } else {
        // マスターと同じ情報元情報を表示する
        document.getElementById('labelCol1').textContent = '情報受領日';
        document.getElementById('infoReceived').textContent = formatDate(row.received || '');
        document.getElementById('labelCol2').textContent = '情報元会社名';
        document.getElementById('infoCompany').textContent = row.company_name || '未紐づけ';
        document.getElementById('labelCol3').textContent = '情報元担当者';
        document.getElementById('infoContact').textContent = row.contact_name || '未紐づけ';
        document.getElementById('labelCol4').textContent = '連絡手段';
        document.getElementById('infoMethod').textContent = row.contact_method || '未設定';
        document.getElementById('detailBody').textContent = row.original || '元情報はありません。';
      }

      subjectInput.value = row.subject || '';
      introInput.value = row.intro || '';
      bodyInput.value = row.body || '';
      signatureInput.value = buildSignature();
      if (sendtoInput) sendtoInput.value = row.target || '';
    } catch (error) {
      console.error(error);
    }
  }

  // 2. フリーメール作成モード（署名以外すべて空白）
  function loadFreeMode() {
    document.title = 'フリーメール作成 | メール配信管理';
    document.getElementById('pageSubTitle').textContent = 'Free Broadcast';
    document.getElementById('pageTitle').textContent = 'フリーメール作成';
    document.getElementById('pageIcon').className = 'w-11 h-11 rounded-xl bg-emerald-500 text-white flex items-center justify-center';
    
    // メタ情報パネルは不要なので隠す
    metaPanel.classList.add('hidden');
    document.getElementById('detailPanel').classList.add('hidden');

    // 署名以外を空にする
    subjectInput.value = '';
    introInput.value = '';
    bodyInput.value = '';
    signatureInput.value = buildSignature();
    sendtoInput.value = '';
  }

  // 3. 案件 / エンジニアからの通常マスター読込
  async function loadMasterData() {
    const titleText = isEngineer ? 'エンジニア配信メール作成' : '案件配信メール作成';
    document.title = `${titleText} | メール配信管理`;
    document.getElementById('pageSubTitle').textContent = isEngineer ? 'Engineer Broadcast' : 'Anken Broadcast';
    document.getElementById('pageTitle').textContent = titleText;
    document.getElementById('pageIcon').className = `w-11 h-11 rounded-xl ${isEngineer ? 'bg-rose-500' : 'bg-blue-600'} text-white flex items-center justify-center`;
    
    const apiUrl = isEngineer ? '/api/get_engineer.php' : '/api/get_anken.php';

    if (!id) {
      subjectInput.value = `${subjectPrefix}${isEngineer ? 'エンジニア' : '案件'}`;
      introInput.value = `${isEngineer ? 'エンジニア' : '案件'}の情報をご紹介します。`;
      bodyInput.value = `${isEngineer ? 'エンジニア' : '案件'}の情報を取得できるようにしてください。`;
      return;
    }

    try {
      const response = await fetch(`${apiUrl}?id=${id}`, { credentials: 'include' });
      const result = await response.json();
      if (result.status !== 'success') throw new Error(result.message || 'データ取得に失敗しました。');
      
      const row = result.data || {};
      document.getElementById('infoReceived').textContent = formatDate(row.received || '');
      document.getElementById('infoCompany').textContent = row.company_name || '未紐づけ';
      document.getElementById('infoContact').textContent = row.contact_name || '未紐づけ';
      document.getElementById('infoMethod').textContent = row.contact_method || '未設定';
      document.getElementById('detailBody').textContent = row.original || '元情報はありません。';

      // 件名・本文などの自動生成を復帰
      subjectInput.value = buildSubject(row);
      introInput.value = buildIntro(row);
      bodyInput.value = buildBody(row);
      signatureInput.value = buildSignature();
    } catch (error) {
      console.error(error);
    }
  }

  // 初期化の振り分け
  if (historyId) {
    loadHistoryData(historyId);
  } else if (isFree) {
    loadFreeMode();
  } else {
    loadMasterData();
  }

  document.getElementById('detailToggle').addEventListener('click', () => {
    const detailPanel = document.getElementById('detailPanel');
    detailPanel.classList.toggle('hidden');
    const isHidden = detailPanel.classList.contains('hidden');
    document.getElementById('detailToggle').innerHTML = isHidden
      ? '<i class="fa-solid fa-up-right-from-square mr-1"></i>詳細'
      : '<i class="fa-solid fa-chevron-up mr-1"></i>閉じる';
  });
const mailForm = document.getElementById('mailForm');
  const confirmModal = document.getElementById('confirmModal');

  // 確認ボタン（submit）を押した時の処理
  mailForm.addEventListener('submit', (e) => {
    e.preventDefault(); // 通常の画面遷移をストップ

    const subj = subjectInput.value;
    const intro = introInput.value;
    const body = bodyInput.value;
    const sig = signatureInput.value;
    const divider = "-・-・-・-・-・-・-・-・-・-・-・-・-・-・-・-・-";

    // メール本文を組み立て
    const fullBody = [
      "株式会社SBT ご担当者様",
      "",
      "いつもお世話になっております、SBT営業部です。",
      "",
      intro,
      "",
      divider,
      body,
      "",
      divider,
      "",
      "以上、何卒よろしくお願いいたします。",
      "",
      sig
    ].join('\n');
    
    // 空行を除外して宛先件数を計算
    const toList = sendtoInput.value.split('\n').filter(l => l.trim() !== '');

    // モーダルへ出力
    document.getElementById('previewSubject').textContent = subj;
    document.getElementById('previewBody').textContent = fullBody;
    document.getElementById('previewToCount').innerHTML = `送信予定: <span class="text-cyan-600 font-bold text-lg">${toList.length}</span> 件`;
    document.getElementById('previewTo').textContent = toList.join('\n');

    confirmModal.classList.remove('hidden');
  });

  function closeConfirmModal() {
    confirmModal.classList.add('hidden');
  }

  // サーバーへ送信（下書き or 配信）
  async function submitAction(action) {
    // ボタンの二重クリック防止
    const btn = event.currentTarget;
    const originalText = btn.innerHTML;
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> 処理中...';
    btn.disabled = true;

    const formData = new FormData(mailForm);
    formData.append('action', action);
    formData.append('type', type);
    if (id) formData.append('id', id);
    if (historyId) formData.append('history_id', historyId);

    // プレビュー用に組み立てた完成形テキストを formData の full_body として追加
    const fullBodyText = document.getElementById('previewBody').textContent;
    formData.append('full_body', fullBodyText);

    try {
      const res = await fetch('/api/save_sendmail_history.php', {
        method: 'POST',
        body: formData,
        credentials: 'include'
      });
      const result = await res.json();
      
      if (result.status === 'success') {
        alert(action === 'draft' ? '下書き保存しました。' : '配信処理を受け付けました！');
        window.location.href = '/sendmail'; // 一覧画面へ戻る
      } else {
        alert('エラーが発生しました: ' + result.message);
        btn.innerHTML = originalText;
        btn.disabled = false;
      }
    } catch (e) {
      alert('通信エラーが発生しました。');
      btn.innerHTML = originalText;
      btn.disabled = false;
    }
  }

  // イベントリスナーの登録
  document.getElementById('saveDraftBtn').addEventListener('click', () => submitAction('draft'));
  document.getElementById('executeSendBtn').addEventListener('click', () => submitAction('sent'));

</script>
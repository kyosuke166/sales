---
import Layout from '../../layouts/Layout.astro';

const menuItems = [
  {
    title: '案件情報',
    description: '配信する案件情報の登録・一覧・編集',
    href: '/sendmail/anken',
    icon: 'fa-briefcase',
    color: 'bg-blue-600',
    active: true,
  },
  {
    title: 'エンジニア情報',
    description: '配信するエンジニア情報の登録・一覧・編集',
    href: '/sendmail/engineer',
    icon: 'fa-user-tie',
    color: 'bg-emerald-600',
    active: true,
  },
  {
    title: '配信履歴',
    description: '配信履歴から確認・再配信',
    href: '#',
    icon: 'fa-paper-plane',
    color: 'bg-cyan-600',
    active: false,
    badge: '準備中',
  },
];
---

<Layout title="メール配信管理 | SBT 営業管理画面">
  <main class="max-w-[1400px] mx-auto px-4 md:px-6 py-6 md:py-8">
    <section class="mb-6 md:mb-8">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4">
        <div>
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-xl bg-cyan-600 text-white flex items-center justify-center shadow-sm">
              <i class="fa-solid fa-envelopes-bulk"></i>
            </div>
            <div>
              <p class="text-xs font-bold text-cyan-600 tracking-wider uppercase">Sendmail</p>
              <h1 class="text-2xl md:text-3xl font-bold text-slate-800">メール配信管理</h1>
            </div>
          </div>
          <p class="text-sm text-slate-500 leading-relaxed max-w-3xl">
            案件とエンジニアの配信情報を登録し、一覧から確認してメール配信へつなげる管理画面です。
          </p>
        </div>

        <div class="flex items-center gap-2 text-xs text-slate-500 bg-white border border-slate-200 rounded-lg px-3 py-2 shadow-sm w-fit">
          <i class="fa-solid fa-database text-cyan-600"></i>
          <span class="font-bold">anken / engineer</span>
        </div>
      </div>
    </section>

    <section class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-5 mb-8">
      {menuItems.map((item) => (
        <a
          href={item.active ? item.href : '#'}
          class={`group bg-white border border-slate-200 rounded-xl p-5 shadow-sm transition-all duration-300 ${item.active ? 'hover:border-cyan-400 hover:shadow-lg hover:-translate-y-0.5' : 'opacity-70 cursor-not-allowed'}`}
          aria-disabled={item.active ? 'false' : 'true'}
        >
          <div class="flex items-start justify-between gap-4 mb-5">
            <div class={`${item.color} w-12 h-12 rounded-xl flex items-center justify-center text-white shadow-sm group-hover:scale-105 transition-transform`}>
              <i class={`fa-solid ${item.icon} text-xl`}></i>
            </div>
            <div class="flex items-center gap-2">
              {item.badge && (
                <span class="px-2 py-1 text-[10px] font-bold tracking-wider rounded-md bg-slate-100 text-slate-500">
                  {item.badge}
                </span>
              )}
              {item.active && (
                <i class="fa-solid fa-chevron-right text-slate-300 text-xs group-hover:text-cyan-500 group-hover:translate-x-1 transition-all"></i>
              )}
            </div>
          </div>

          <div class="space-y-2">
            <div class="flex items-center gap-2">
              <h2 class="text-lg font-bold text-slate-800 group-hover:text-cyan-700 transition-colors">{item.title}</h2>
              <span class="text-[10px] font-bold text-slate-400 bg-slate-50 border border-slate-100 rounded px-2 py-0.5">{item.stats}</span>
            </div>
            <p class="text-sm text-slate-500 leading-relaxed">{item.description}</p>
          </div>
        </a>
      ))}
    </section>

    <section class="grid grid-cols-1 lg:grid-cols-2 gap-5">
      <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-9 h-9 rounded-lg bg-slate-100 text-slate-600 flex items-center justify-center">
            <i class="fa-solid fa-list-check"></i>
          </div>
          <h2 class="text-base font-bold text-slate-800">登録する情報</h2>
        </div>
        <div class="space-y-3 text-sm text-slate-600">
          <div class="flex items-start gap-3">
            <span class="mt-1 w-2 h-2 rounded-full bg-blue-500 flex-shrink-0"></span>
            <p>案件は案件名、期間、エリア、単金、スキル、元情報を中心に管理します。</p>
          </div>
          <div class="flex items-start gap-3">
            <span class="mt-1 w-2 h-2 rounded-full bg-emerald-500 flex-shrink-0"></span>
            <p>エンジニアはイニシャル、稼働時期、所属、単価、スキルシート、スキルを中心に管理します。</p>
          </div>
          <div class="flex items-start gap-3">
            <span class="mt-1 w-2 h-2 rounded-full bg-cyan-500 flex-shrink-0"></span>
            <p>情報元の会社・担当者はCRMに紐づく場合だけ選択し、紐づかない情報は元情報の冒頭に残します。</p>
          </div>
        </div>
      </div>

      <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-9 h-9 rounded-lg bg-slate-100 text-slate-600 flex items-center justify-center">
            <i class="fa-solid fa-signal"></i>
          </div>
          <h2 class="text-base font-bold text-slate-800">状態</h2>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="rounded-lg border border-slate-200 bg-slate-50 p-3">
            <p class="text-[10px] font-bold text-slate-400 uppercase mb-1">draft</p>
            <p class="text-sm font-bold text-slate-700">下書き</p>
          </div>
          <div class="rounded-lg border border-cyan-100 bg-cyan-50 p-3">
            <p class="text-[10px] font-bold text-cyan-500 uppercase mb-1">active</p>
            <p class="text-sm font-bold text-slate-700">募集中 / 営業中</p>
          </div>
          <div class="rounded-lg border border-slate-200 bg-slate-50 p-3">
            <p class="text-[10px] font-bold text-slate-400 uppercase mb-1">closed</p>
            <p class="text-sm font-bold text-slate-700">終了</p>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

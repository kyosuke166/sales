---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="メール配信管理 | SBT 営業管理画面">
  <main class="max-w-[1400px] mx-auto px-4 md:px-6 py-6 md:py-8">
    <!-- ヘッダーセクション -->
    <section class="mb-6 md:mb-8">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4">
        <div>
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-xl bg-amber-500 text-white flex items-center justify-center shadow-sm">
              <i class="fa-solid fa-envelopes-bulk"></i>
            </div>
            <div>
              <p class="text-xs font-bold text-amber-600 tracking-wider uppercase">Sendmail</p>
              <h1 class="text-2xl md:text-3xl font-bold text-slate-800">メール配信管理</h1>
            </div>
          </div>
          <p class="text-sm text-slate-500 leading-relaxed max-w-3xl">
            案件・エンジニア情報の配信、または自由な内容のフリーメール作成・過去の配信履歴の確認を行います。
          </p>
        </div>

        <div class="flex items-center gap-2 text-xs text-slate-500 bg-white border border-slate-200 rounded-lg px-3 py-2 shadow-sm w-fit">
          <i class="fa-solid fa-database text-cyan-600"></i>
          <span class="font-bold">anken / engineer / sendmail_history</span>
        </div>
      </div>
    </section>

    <!-- 上部：3カラムカード（ヘッダーの青・赤・緑ドットとカラー同期） -->
    <section class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-8">
      <!-- 案件情報（青ドット同期） -->
      <a
        href="/sendmail/anken"
        class="group bg-white border border-slate-200 rounded-xl p-6 shadow-sm hover:border-blue-400 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300"
      >
        <div class="flex items-start justify-between gap-4 mb-4">
          <div class="bg-blue-600 w-12 h-12 rounded-xl flex items-center justify-center text-white shadow-sm group-hover:scale-105 transition-transform">
            <i class="fa-solid fa-briefcase text-xl"></i>
          </div>
          <i class="fa-solid fa-chevron-right text-slate-300 text-xs group-hover:text-blue-500 group-hover:translate-x-1 transition-all self-center"></i>
        </div>
        <h2 class="text-lg font-bold text-slate-800 group-hover:text-blue-700 transition-colors mb-1">案件情報</h2>
        <p class="text-sm text-slate-500">案件情報の登録・一覧・編集、および個別配信メールの作成を行います。</p>
      </a>

      <!-- エンジニア情報（赤ドット同期） -->
      <a
        href="/sendmail/engineer"
        class="group bg-white border border-slate-200 rounded-xl p-6 shadow-sm hover:border-rose-400 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300"
      >
        <div class="flex items-start justify-between gap-4 mb-4">
          <div class="bg-rose-500 w-12 h-12 rounded-xl flex items-center justify-center text-white shadow-sm group-hover:scale-105 transition-transform">
            <i class="fa-solid fa-user-tie text-xl"></i>
          </div>
          <i class="fa-solid fa-chevron-right text-slate-300 text-xs group-hover:text-rose-500 group-hover:translate-x-1 transition-all self-center"></i>
        </div>
        <h2 class="text-lg font-bold text-slate-800 group-hover:text-rose-700 transition-colors mb-1">エンジニア情報</h2>
        <p class="text-sm text-slate-500">エンジニア情報の登録・一覧・編集、および個別配信メールの作成を行います。</p>
      </a>

      <!-- フリーメール作成（緑ドット同期） -->
      <a
        href="/sendmail/broadcast?type=free"
        class="group bg-white border border-slate-200 rounded-xl p-6 shadow-sm hover:border-emerald-400 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300"
      >
        <div class="flex items-start justify-between gap-4 mb-4">
          <div class="bg-emerald-500 w-12 h-12 rounded-xl flex items-center justify-center text-white shadow-sm group-hover:scale-105 transition-transform">
            <i class="fa-solid fa-pen-to-square text-xl"></i>
          </div>
          <i class="fa-solid fa-chevron-right text-slate-300 text-xs group-hover:text-emerald-500 group-hover:translate-x-1 transition-all self-center"></i>
        </div>
        <h2 class="text-lg font-bold text-slate-800 group-hover:text-emerald-700 transition-colors mb-1">フリーメール作成</h2>
        <p class="text-sm text-slate-500">案件やエンジニアに紐づかない、自由な内容のダイレクトメールを作成・配信します。</p>
      </a>
    </section>

    <!-- 下部：配信履歴一覧セクション -->
    <section class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm">
      <div class="flex items-center justify-between mb-5">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-lg bg-amber-500 text-white flex items-center justify-center shadow-sm">
            <i class="fa-solid fa-paper-plane text-sm"></i>
          </div>
          <h2 class="text-base font-bold text-slate-800">配信履歴</h2>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-slate-200 text-xs font-bold text-slate-400 uppercase bg-slate-50">
              <th class="py-3 px-4">配信日時</th>
              <th class="py-3 px-4">状態</th>
              <th class="py-3 px-4">種別</th>
              <th class="py-3 px-4">件名</th>
              <th class="py-3 px-4">操作</th>
            </tr>
          </thead>
          <tbody id="historyTableBody" class="text-sm text-slate-600 divide-y divide-slate-100">
            <tr>
              <td colspan="5" class="py-6 text-center text-slate-400">読み込み中...</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- 進捗確認用モーダル ▼ -->
    <div id="progressModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[200] hidden flex items-center justify-center p-4">
      <div class="bg-white rounded-2xl shadow-2xl w-full max-w-3xl overflow-hidden flex flex-col">
        <div class="px-6 py-4 border-b border-slate-200 flex justify-between items-center bg-slate-50">
          <h3 class="font-bold text-slate-800 flex items-center gap-2">
            <i class="fa-solid fa-satellite-dish text-cyan-600 fa-beat-fade"></i> 配信状況の確認
          </h3>
          <button type="button" onclick="closeProgressModal()" class="text-slate-400 hover:text-slate-600 transition outline-none">
            <i class="fa-solid fa-xmark text-xl"></i>
          </button>
        </div>
        <div class="p-6 flex flex-col gap-5">
          <!-- カウント＆プログレスバー -->
          <div>
            <div class="flex justify-between items-end mb-2">
              <span id="progressStatusText" class="text-xs font-bold text-cyan-600 px-2 py-1 bg-cyan-50 rounded">配信中...</span>
              <span class="font-mono font-bold text-slate-700">
                <span id="progressCurrent" class="text-2xl text-cyan-600">0</span> / <span id="progressTotal">0</span> 件 
                (<span id="progressPercent" class="text-sm">0%</span>)
              </span>
            </div>
            <div class="w-full h-3 bg-slate-100 rounded-full overflow-hidden shadow-inner">
              <div id="progressBar" class="h-full bg-cyan-500 transition-all duration-500 ease-out w-0 relative">
                <!-- 光るエフェクト -->
                <div class="absolute top-0 left-0 right-0 bottom-0 bg-white/20 w-full h-full animate-[shimmer_2s_infinite]"></div>
              </div>
            </div>
          </div>
          <!-- tail -f 風 ログビューアー -->
          <div class="bg-slate-900 rounded-xl p-4 shadow-inner border border-slate-700">
            <div class="flex items-center gap-2 mb-2 pb-2 border-b border-slate-700/50">
              <div class="w-3 h-3 rounded-full bg-rose-500"></div>
              <div class="w-3 h-3 rounded-full bg-amber-500"></div>
              <div class="w-3 h-3 rounded-full bg-emerald-500"></div>
              <span class="text-[10px] text-slate-500 font-mono ml-2">server.log (tail -f)</span>
            </div>
            <div id="progressLogViewer" class="h-64 overflow-y-auto font-mono text-[11px] text-emerald-400 whitespace-pre-wrap leading-relaxed tracking-wider">
              waiting for logs...
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script is:inline>
  async function loadHistory() {
    try {
      const res = await fetch('/api/get_sendmail_history.php', { credentials: 'include' });
      const json = await res.json();
      const tbody = document.getElementById('historyTableBody');
      
      if (json.status !== 'success' || !json.data || json.data.length === 0) {
        tbody.innerHTML = '<tr><td colspan="4" class="py-6 text-center text-slate-400">配信履歴はありません。</td></tr>';
        return;
      }

      tbody.innerHTML = json.data.map(item => {
        // ▼ 1. 種別バッジの判定
        let typeBadge = '<span class="px-2 py-0.5 text-xs font-bold bg-emerald-50 text-emerald-600 rounded">フリー</span>';
        if (item.engineer_id) {
          typeBadge = '<span class="px-2 py-0.5 text-xs font-bold bg-rose-50 text-rose-600 rounded">エンジニア</span>';
        } else if (item.anken_id) {
          typeBadge = '<span class="px-2 py-0.5 text-xs font-bold bg-blue-50 text-blue-600 rounded">案件</span>';
        }

        // ▼ 2. 状態（ステータス）バッジと、ボタンテキストの判定
        let statusBadge = '';
        let actionBtn = '';
        const targetUrl = `/sendmail/broadcast?history_id=${item.id}`;

        switch (item.status) {
          case 'draft':
            // 下書き：黄色系（作業のやり残し・注意喚起）
            statusBadge = '<span class="px-2 py-1 text-[10px] font-bold bg-amber-50 text-amber-600 rounded border border-amber-200">下書き</span>';
            actionBtn = `<a href="${targetUrl}" class="px-3 py-1.5 bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 text-xs font-bold rounded transition shadow-sm"><i class="fa-solid fa-pen mr-1 text-slate-400"></i>再開する</a>`;
            break;
          case 'sent':
            // 送信済：グレー系（完了した過去のデータとして視覚的なノイズを減らす）
            statusBadge = '<span class="px-2 py-1 text-[10px] font-bold bg-slate-100 text-slate-500 rounded border border-slate-200">送信済</span>';
            actionBtn = `<a href="${targetUrl}" class="px-3 py-1.5 bg-slate-50 hover:bg-slate-100 text-slate-600 text-xs font-bold rounded transition border border-slate-200">確認・再配信</a>`;
            break;
          case 'scheduled':
            // 予約中：緑系（正常にスケジュールされて待機している安心感）
            statusBadge = '<span class="px-2 py-1 text-[10px] font-bold bg-emerald-50 text-emerald-600 rounded border border-emerald-200">予約中</span>';
            actionBtn = `<a href="${targetUrl}" class="px-3 py-1.5 bg-white border border-emerald-200 hover:bg-emerald-50 text-emerald-700 text-xs font-bold rounded transition">確認・変更</a>`;
            break;
          case 'error':
            // エラー：赤系＆3文字（直感的な警告）
            statusBadge = '<span class="px-2 py-1 text-[10px] font-bold bg-rose-50 text-rose-600 rounded border border-rose-200">エラー</span>';
            actionBtn = `<a href="${targetUrl}" class="px-3 py-1.5 bg-rose-50 border border-rose-200 hover:bg-rose-100 text-rose-700 text-xs font-bold rounded transition">詳細・再送</a>`;
            break;
          case 'sending': // ★ 新規追加！
            statusBadge = '<span class="px-2 py-1 text-[10px] font-bold bg-cyan-50 text-cyan-600 rounded border border-cyan-200 animate-pulse"><i class="fa-solid fa-spinner fa-spin mr-1"></i>配信中</span>';
            actionBtn = `<button onclick="openProgressModal(${item.id})" class="px-3 py-1.5 bg-cyan-50 hover:bg-cyan-100 border border-cyan-200 text-cyan-700 text-xs font-bold rounded transition shadow-sm outline-none"><i class="fa-solid fa-satellite-dish mr-1"></i>進捗</button>`;
            break;
          default:
            statusBadge = `<span class="px-2 py-1 text-[10px] font-bold bg-slate-50 text-slate-400 rounded">${item.status || '---'}</span>`;
            actionBtn = `<a href="${targetUrl}" class="px-3 py-1.5 bg-slate-100 text-slate-700 text-xs font-bold rounded transition">詳細</a>`;
        }

        // ▼ 3. ログダウンロードボタンの判定（送信済かつ total_count が存在する場合）
        let logDownloadBtn = '';
        if (item.status === 'sent' && item.total_count && Number(item.total_count) > 0) {
          const tooltipText = `全体: ${item.total_count}件 / 成功: ${item.success_count}件 / 失敗: ${item.error_count}件`;
          const formattedId = String(item.id).padStart(6, '0');
          const logUrl = `/storage/log/sendmail_history_${formattedId}.csv`;
          logDownloadBtn = `
            <a href="${logUrl}" 
               title="${tooltipText}"
               download
               class="p-1 text-slate-400 hover:text-cyan-600 text-lg transition-colors outline-none"
               target="_blank">
               <i class="fa-solid fa-file-csv"></i>
            </a>`;
        }

        // ▼ 4. 行の出力（状態カラムを追加）
        return `
          <tr class="hover:bg-slate-50 transition">
            <td class="py-3 px-4 whitespace-nowrap text-slate-500 text-xs">${item.senddate}</td>
            <td class="py-3 px-4 whitespace-nowrap">${statusBadge}</td>
            <td class="py-3 px-4 whitespace-nowrap">${typeBadge}</td>
            <td class="py-3 px-4 font-bold text-slate-800 max-w-md truncate">${item.subject}</td>
            <td class="py-3 px-4 whitespace-nowrap">
              <!-- ↓↓↓ ここのdivと ${logDownloadBtn} が入っているか確認！ ↓↓↓ -->
              <div class="flex items-center gap-2">
                ${actionBtn}
                ${logDownloadBtn}
              </div>
              <!-- ↑↑↑ ------------------------------------------ ↑↑↑ -->
            </td>
          </tr>
        `;
      }).join('');
    } catch (e) {
      console.error(e);
      document.getElementById('historyTableBody').innerHTML = '<tr><td colspan="4" class="py-6 text-center text-red-400">履歴の取得に失敗しました。</td></tr>';
    }
  }

  loadHistory();

  // --- 進捗モーダル制御用 ---
  let progressTimer = null;
  const progressModal = document.getElementById('progressModal');
  const logViewer = document.getElementById('progressLogViewer');
  const progressBar = document.getElementById('progressBar');

  function openProgressModal(id) {
    progressModal.classList.remove('hidden');
    logViewer.innerHTML = 'Connecting to server...';
    progressBar.style.width = '0%';
    
    // 初回即時実行
    fetchProgress(id);
    // 以降、1.5秒に1回ポーリング
    progressTimer = setInterval(() => fetchProgress(id), 1500);
  }

  function closeProgressModal() {
    progressModal.classList.add('hidden');
    if (progressTimer) {
      clearInterval(progressTimer);
      progressTimer = null;
    }
  }

  async function fetchProgress(id) {
    try {
      const res = await fetch(`/api/get_sendmail_progress.php?id=${id}`);
      const json = await res.json();
      if (json.status !== 'success') return;

      const total = json.total || 0;
      const current = json.current || 0;
      const percent = total > 0 ? Math.floor((current / total) * 100) : 0;

      document.getElementById('progressTotal').textContent = total;
      document.getElementById('progressCurrent').textContent = current;
      document.getElementById('progressPercent').textContent = percent + '%';
      progressBar.style.width = percent + '%';

      // ログの流し込み（黒い画面）
      if (json.logs && json.logs.length > 0) {
        logViewer.innerHTML = json.logs.map(line => {
          // カンマ区切りのCSVをスペースに置換してターミナルっぽく見せる
          let text = line.replace(/,/g, '  |  ');
          // 「失敗」の文字があれば赤色にする
          if (text.includes('失敗')) {
            return `<span class="text-rose-400">${text}</span>`;
          }
          return text;
        }).join('\n');
      }

      // 常に一番下へ自動スクロール (tail -f の挙動)
      logViewer.scrollTop = logViewer.scrollHeight;

      // ステータスが sent (または error) になったらポーリング終了
      if (json.task_status !== 'sending' && json.task_status !== 'waiting') {
        document.getElementById('progressStatusText').textContent = '配信完了';
        document.getElementById('progressStatusText').className = 'text-xs font-bold text-emerald-600 px-2 py-1 bg-emerald-50 rounded border border-emerald-200';
        clearInterval(progressTimer);
        progressTimer = null;
        // 一覧も最新にしたい場合はここで loadHistory() を呼ぶと良いです
        loadHistory();
      } else {
        document.getElementById('progressStatusText').textContent = '配信中...';
        document.getElementById('progressStatusText').className = 'text-xs font-bold text-cyan-600 px-2 py-1 bg-cyan-50 rounded border border-cyan-200 animate-pulse';
      }

    } catch (e) {
      console.error(e);
    }
  }
</script>
---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="案件・契約管理">
  <div class="container mx-auto px-2 md:px-4 py-4 md:py-8">
    <div class="flex flex-col md:flex-row md:justify-between md:items-center mb-6 md:mb-8 gap-4">
      <h1 class="text-2xl md:text-3xl font-bold text-gray-800">案件・契約管理</h1>
      
      <div class="flex flex-wrap items-center gap-4 md:gap-6">
        <label class="relative inline-flex items-center cursor-pointer">
          <input type="checkbox" id="filter-all" class="sr-only peer">
          <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
          <span class="ml-3 text-sm font-medium text-gray-600 font-bold">終了案件も含める</span>
        </label>
        <a href="/projects/new" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded shadow transition-colors text-sm md:text-base">
          + 新規登録
        </a>
      </div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4 mb-6 md:mb-10">
      <div class="bg-white p-3 md:p-4 rounded-lg shadow border-t-4 border-blue-500">
        <h2 class="text-[10px] md:text-xs font-bold text-gray-500 uppercase">請求書送付 (Out)</h2>
        <p class="text-lg md:text-xl font-bold text-blue-600"><span id="count-send-invoice">--</span> <span class="text-xs text-gray-400">件</span></p>
      </div>
      <div class="bg-white p-3 md:p-4 rounded-lg shadow border-t-4 border-blue-300">
        <h2 class="text-[10px] md:text-xs font-bold text-gray-500 uppercase">入金確認 (In)</h2>
        <p class="text-lg md:text-xl font-bold text-blue-400"><span id="count-confirm-deposit">--</span> <span class="text-xs text-gray-400">件</span></p>
      </div>
      <div class="bg-white p-3 md:p-4 rounded-lg shadow border-t-4 border-red-400">
        <h2 class="text-[10px] md:text-xs font-bold text-gray-500 uppercase">請求書受取 (In)</h2>
        <p class="text-lg md:text-xl font-bold text-red-500"><span id="count-receive-invoice">--</span> <span class="text-xs text-gray-400">件</span></p>
      </div>
      <div class="bg-white p-3 md:p-4 rounded-lg shadow border-t-4 border-red-300">
        <h2 class="text-[10px] md:text-xs font-bold text-gray-500 uppercase">支払実行 (Out)</h2>
        <p class="text-lg md:text-xl font-bold text-red-400"><span id="count-make-payment">--</span> <span class="text-xs text-gray-400">件</span></p>
      </div>
    </div>

    <div class="bg-white shadow rounded-lg overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 md:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">案件名 / 上位会社</th>
            <th class="hidden md:table-cell px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">要員</th>
            <th class="hidden md:table-cell px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">期間</th>
            <th class="px-4 md:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">単価 / 状況</th>
            <th class="hidden md:table-cell px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">状態</th>
          </tr>
        </thead>
        <tbody id="project-list" class="bg-white divide-y divide-gray-200">
          <tr>
            <td colspan="5" class="px-6 py-10 text-center text-gray-400 italic">データを読み込み中...</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</Layout>

<script is:inline>
  async function loadProjects() {
    const listEl = document.getElementById('project-list');
    
    try {
      const res = await fetch('/api/get_projects.php');
      const data = await res.json();

      if (data.status === 'success') {
        // カウント更新ロジック
        if (data.counts) {
          updateBadge('count-send-invoice', data.counts.send_invoice);
          updateBadge('count-confirm-deposit', data.counts.confirm_deposit);
          updateBadge('count-receive-invoice', data.counts.receive_invoice);
          updateBadge('count-make-payment', data.counts.make_payment);
        }

        // 数字がある時だけ強調するヘルパー
        function updateBadge(id, count) {
          const el = document.getElementById(id);
          const num = Number(count) || 0;
          el.textContent = num;
          
          // 親要素のスタイルを調整（例：0件なら薄く、1件以上ならハッキリ）
          const container = el.closest('.bg-white');
          if (num > 0) {
            container.classList.remove('opacity-50');
            el.classList.add('animate-pulse'); // 1件以上あれば少し動かしてアピール
          } else {
            container.classList.add('opacity-50');
            el.classList.remove('animate-pulse');
          }
        }

        listEl.innerHTML = '';
        const projects = data.projects || data.data;

        if (!projects || projects.length === 0) {
          listEl.innerHTML = '<tr><td colspan="5" class="px-6 py-10 text-center text-gray-400">登録された案件はありません。</td></tr>';
          return;
        }

        projects.forEach(p => {
          const tr = document.createElement('tr');
          tr.setAttribute('data-status', p.status);
          tr.className = 'project-row hover:bg-blue-50 transition-colors cursor-pointer group border-b border-gray-100';
          
          const amountStr = p.amount ? `¥${Number(p.amount).toLocaleString()}` : '---';
          const start = (p.start_date || '').replaceAll('-', '/');
          const end = (p.end_date || '').replaceAll('-', '/');
          const dateStr = (start || end) ? `${start || '--'} 〜 ${end || '--'}` : '---';
          const siteStr = p.payment_site ? `${p.payment_site}日サイト` : '';
          
          // 1が稼働中、それ以外（0）が終了
          const isActive = Number(p.status) === 1;

          tr.innerHTML = `
              <td class="px-4 md:px-6 py-4">
                  <div class="text-sm font-bold text-gray-900 group-hover:text-blue-700">${escapeHtml(p.project_name)}</div>
                  <div class="text-[11px] md:text-xs text-gray-500">${escapeHtml(p.company_name || '---')}</div>
                  <div class="md:hidden text-[11px] text-blue-500 mt-1">${escapeHtml(p.worker_name || '---')}</div>
              </td>
              <td class="hidden md:table-cell px-6 py-4 text-sm text-gray-600">${escapeHtml(p.worker_name || '---')}</td>
              <td class="hidden md:table-cell px-6 py-4 text-xs text-gray-500">
                  <div>${dateStr}</div>
                  <div class="text-[10px] text-slate-400 mt-1">${escapeHtml(siteStr)}</div>
              </td>
              <td class="px-4 md:px-6 py-4">
                  <div class="text-sm font-mono text-gray-700 font-bold md:font-normal">${amountStr}</div>
                  <div class="md:hidden mt-2">
                    <span class="px-2 py-0.5 text-[10px] font-semibold rounded-full ${isActive ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800'}">
                      ${isActive ? '稼働中' : '終了'}
                    </span>
                  </div>
              </td>
              <td class="hidden md:table-cell px-6 py-4">
                  <button 
                    onclick="event.stopPropagation(); toggleStatus(event, ${p.id}, ${p.status})"
                    class="px-3 py-1 inline-flex text-xs leading-5 font-semibold rounded-full transition-all hover:scale-105 ${isActive ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800'}"
                  >
                    ${isActive ? '稼働中' : '終了'}
                  </button>
              </td>
          `;

          tr.onclick = () => {
            location.href = `/projects/detail?id=${p.id}`;
          };

          listEl.appendChild(tr);
        });
      }
      applyFilter();
    } catch (e) {
      console.error(e);
      listEl.innerHTML = '<tr><td colspan="5" class="px-6 py-10 text-center text-red-500">読み込みエラー</td></tr>';
    }
  }

  // 4. ステータス切り替え用関数
  window.toggleStatus = async (event, id, currentStatus) => {
    const newStatus = Number(currentStatus) === 1 ? 0 : 1;
    
    if (!confirm(`ステータスを「${newStatus === 1 ? '稼働中' : '終了'}」に変更しますか？`)) return;

    try {
      const formData = new FormData();
      formData.append('id', id);
      formData.append('status', newStatus);

      const res = await fetch('/api/save_project.php', {
        method: 'POST',
        body: formData
      });
      const result = await res.json();

      if (result.status === 'success') {
        // これで event.target が正しく取得できます
        const btn = event.target; 
        const tr = btn.closest('tr');
        
        tr.setAttribute('data-status', newStatus);
        
        // 次回クリック時のために引数を更新
        btn.setAttribute('onclick', `event.stopPropagation(); toggleStatus(event, ${id}, ${newStatus})`);
        
        // 見た目の色も変えておきましょうか
        if (newStatus === 1) {
          btn.textContent = '稼働中';
          btn.className = btn.className.replace('bg-gray-100 text-gray-800', 'bg-green-100 text-green-800');
        } else {
          btn.textContent = '終了';
          btn.className = btn.className.replace('bg-green-100 text-green-800', 'bg-gray-100 text-gray-800');
        }
        applyFilter();
      } else {
        alert('エラー: ' + result.message);
      }
    } catch (e) {
      console.error(e);
      alert('通信エラーが発生しました');
    }
  };

  function applyFilter() {
  const showAll = document.getElementById('filter-all').checked;
  const rows = document.querySelectorAll('.project-row');

  rows.forEach(row => {
    const status = row.getAttribute('data-status');
    if (showAll || status === '1') {
      row.style.display = ''; // 表示
    } else {
      row.style.display = 'none'; // 非表示
    }
  });
}

// スイッチのイベントリスナー
document.getElementById('filter-all').addEventListener('change', applyFilter);

  function escapeHtml(str) {
    if (!str) return '';
    const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
    return str.replace(/[&<>"']/g, m => map[m]);
  }

  loadProjects();
</script>
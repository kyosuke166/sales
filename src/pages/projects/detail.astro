---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="案件詳細">
  <div class="container mx-auto px-4 py-8">
    <div class="mb-6">
      <a href="/projects" class="text-slate-500 hover:text-slate-700 font-bold text-sm flex items-center gap-1">
        <i class="fa-solid fa-arrow-left"></i> 案件一覧へ戻る
      </a>
    </div>

    <div class="flex flex-col md:flex-row md:items-end gap-6 mb-8 border-b pb-6">
      <div class="flex-1">
        <h1 id="display-project-name" class="text-3xl font-bold text-gray-800">読み込み中...</h1>
        <p class="text-slate-500 mt-2 font-mono text-xs uppercase tracking-tighter">PROJECT ID: <span id="display-id">--</span></p>
      </div>
      <div class="md:w-1/3 bg-slate-50 rounded-lg border border-slate-200 p-4 relative">
        <h3 class="text-slate-500 text-[10px] font-bold uppercase tracking-widest mb-1 flex items-center gap-1">
          <i class="fa-solid fa-sticky-note"></i> 案件備考
        </h3>
        <p id="display-memo" class="text-slate-700 text-sm whitespace-pre-wrap leading-relaxed">--</p>
      </div>
    </div>

    <div class="bg-amber-50 rounded-xl border border-amber-200 shadow-sm p-6 mb-10 flex flex-wrap gap-8 items-center justify-around">
      <div class="flex flex-col items-center">
        <span class="text-amber-700 text-[10px] font-bold uppercase tracking-widest mb-1">売上 (受注額)</span>
        <span id="summary-sales" class="font-mono text-2xl font-bold text-amber-900">¥0</span>
      </div>
      <div class="text-amber-300 text-2xl">−</div>
      <div class="flex flex-col items-center">
        <span class="text-amber-700 text-[10px] font-bold uppercase tracking-widest mb-1">原価 (発注額)</span>
        <span id="summary-cost" class="font-mono text-2xl font-bold text-amber-900">¥0</span>
      </div>
      <div class="text-amber-300 text-2xl">＝</div>
      <div class="flex flex-col items-center border-l border-amber-200 pl-8">
        <span class="font-bold text-orange-600 text-[10px] uppercase tracking-widest mb-1">見込粗利</span>
        <span id="summary-profit" class="font-mono text-3xl font-bold text-orange-600">¥0</span>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <div id="in-section-container" class="bg-white rounded-xl shadow-sm border border-blue-200 overflow-hidden min-h-[500px]"></div>
      <div id="out-section-container" class="bg-white rounded-xl shadow-sm border border-emerald-200 overflow-hidden min-h-[500px]"></div>
    </div>
  </div>
</Layout>

<style is:global>
  .item-label { display: block; font-size: 10px; font-weight: 800; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.25rem; }
  .font-mono { font-family: 'JetBrains Mono', 'Fira Code', 'Courier New', monospace; }
</style>

<script is:inline>
  (function() {
    const urlParams = new URLSearchParams(window.location.search);
    const projectId = urlParams.get('id');

    const formatDate = (dateStr) => {
      if (!dateStr) return '--';
      return dateStr.replaceAll('-', '/');
    };

    // 【重要】共通のHTMLテンプレート。ここを1箇所直せば、左右両方のフォント・構造が揃います。
    function generateInfoCard(type, data) {
      const isIn = type === 'in';
      const color = isIn ? 'blue' : 'emerald';
      const title = isIn ? '受注情報' : '発注情報';
      const pdfLabel = isIn ? '受領済み注文書 (PDF)' : '発行済み注文書 (PDF)';
      
      // 発注データがない場合の表示
      if (!isIn && !data.order_out_id) {
        return `
          <div class="bg-emerald-50 px-6 py-4 border-b border-emerald-100">
            <h2 class="font-bold text-emerald-800 flex items-center gap-2 text-base italic"><i class="fa-solid fa-file-export"></i> ${title}</h2>
          </div>
          <div class="flex flex-col items-center justify-center h-full p-12 text-center">
            <p class="text-slate-300 mb-6 italic text-sm">下位会社への発注情報が登録されていません</p>
            <a href="/projects/order_out?project_id=${projectId}" class="border-2 border-dashed border-emerald-200 text-emerald-600 px-8 py-4 rounded-xl font-bold hover:bg-emerald-50 transition-all text-sm">
              <i class="fa-solid fa-plus mr-2"></i> 下位への発注を登録する
            </a>
          </div>`;
      }

      // 共通のデータ抽出
      const orderNum = isIn ? data.order_number : data.out_order_number;
      const company = isIn ? data.company_name : data.out_company_name;
      const contact = isIn ? data.in_contact_name : data.out_contact_name;
      const worker = isIn ? data.worker_name : data.out_worker_name;
      const amount = isIn ? data.amount : data.out_amount;
      const range = isIn ? data.time_range : data.out_time_range;
      const start = isIn ? data.start_date : data.out_start_date;
      const end = isIn ? data.end_date : data.out_end_date;
      const site = isIn ? data.payment_site : data.out_payment_site;
      const filePath = isIn ? data.file_path : data.out_file_path;
      const editUrl = isIn ? `/projects/edit?id=${projectId}` : `/projects/order_out?id=${data.order_out_id}&project_id=${projectId}`;

      return `
        <div class="bg-${color}-50 px-6 py-4 border-b border-${color}-100 flex justify-between items-center">
          <h2 class="font-bold text-${color}-800 flex items-center gap-2 text-base">
            <i class="fa-solid ${isIn ? 'fa-file-import' : 'fa-file-export'}"></i> ${title}
          </h2>
          <a href="${editUrl}" class="text-${color}-600 text-xs font-bold hover:underline flex items-center gap-1">
            <i class="fa-solid fa-pen-to-square"></i> 編集
          </a>
        </div>
        <div class="p-8 space-y-6 text-sm">
          <div><label class="item-label">注文番号</label><p class="font-mono font-bold text-slate-700 text-base">${orderNum || '---'}</p></div>
          <div><label class="item-label">${isIn ? '取引先会社' : '所属会社'}</label><p class="font-bold text-slate-700 text-base">${company || '---'}</p></div>
          <div><label class="item-label">先方担当者</label><p class="font-bold text-slate-700 text-base">${(contact || '').trim() || '---'}</p></div>
          <div><label class="item-label">要員名</label><p class="font-bold text-slate-700 text-base">${worker || '---'}</p></div>
          <div>
            <label class="item-label">単価 / 精算幅</label>
            <div class="flex items-baseline gap-2">
              <span class="font-mono font-bold text-slate-700 text-lg">¥${Number(amount || 0).toLocaleString()}</span>
              <span class="text-slate-500 font-bold text-xs font-mono">${range ? `(${range}h)` : ''}</span>
            </div>
          </div>
          <div><label class="item-label">契約期間</label><p class="font-bold text-slate-700 text-base">${formatDate(start)} 〜 ${formatDate(end)}</p></div>
          <div><label class="item-label">支払サイト</label><p class="font-bold text-slate-700 text-base">${site || '---'}</p></div>
          <div class="pt-6 border-t border-slate-100 flex items-center justify-between">
            <label class="item-label !mb-0">${pdfLabel}</label>
            ${filePath 
              ? `<a href="/${filePath}" target="_blank" class="inline-flex items-center gap-2 bg-slate-800 text-white px-4 py-2 rounded text-xs font-bold hover:bg-slate-700 transition-colors shadow-sm"><i class="fa-solid fa-file-pdf"></i> PDFを表示</a>` 
              : '<span class="text-slate-300 italic text-xs">未登録</span>'}
          </div>
        </div>
      `;
    }

    async function loadDetail() {
      if (!projectId) return;
      try {
        const res = await fetch(`/api/get_projects.php?id=${projectId}`);
        const result = await res.json();
        
        if (result.status === 'success') {
          const p = result.data;
          
          // 基本情報
          document.getElementById('display-project-name').textContent = p.project_name;
          document.getElementById('display-id').textContent = p.id;
          document.getElementById('display-memo').textContent = p.memo || '備考なし';

          // 受注・発注カード生成（共通関数を使用）
          document.getElementById('in-section-container').innerHTML = generateInfoCard('in', p);
          document.getElementById('out-section-container').innerHTML = generateInfoCard('out', p);

          // 収支サマリー
          const sales = Number(p.amount || 0);
          const cost = Number(p.out_amount || 0);
          document.getElementById('summary-sales').textContent = `¥${sales.toLocaleString()}`;
          document.getElementById('summary-cost').textContent = `¥${cost.toLocaleString()}`;
          document.getElementById('summary-profit').textContent = `¥${(sales - cost).toLocaleString()}`;
        }
      } catch (e) { console.error(e); }
    }
    loadDetail();
  })();
</script>